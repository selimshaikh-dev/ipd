@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model List<AdmissionsDto>
@{
    ViewBag.Title = "Admission";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    string? patientId = ViewBag.PatientId as string;
    bool hasDeaDeathCertificates = ViewBag.HasDeaDeathCertificates ?? false;
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Admissions</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <div class="col-md-10 offset-1">
        @{
            var canAdmission = Model.All(x => x.IsDischarged);
            if (canAdmission && !hasDeaDeathCertificates)
            {
                <a class="btn btn-primary customBtn mt-3 fs-6" href="@Url.ActionLink("Create", "Admissions", new { patientId })"><span>Add New</span></a>
            }
        }
    </div>

    <!--Header-->
    <div class="col-md-10 offset-1 mt-3">
        @await Component.InvokeAsync("ClientInfo", new { patientId = patientId })
    </div>

    <!--Body content Start-->
    <div class="col-md-10 offset-1 mt-4 table-responsive">
        <table class="table table-bordered table-condensed tbl">
            <thead>
                <tr colspan="5">
                    <th>Admission date</th>
                    <th>Admission time</th>
                    <th>Discharge date</th>
                    <th>Discharge time</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admission in Model)
                {
                    <tr>
                        <td>@admission.AdmissionDate.ToString("dd-MM-yyyy")</td>
                        <td>@admission.AdmissionTime.ToShortTimeString()</td>
                        @{
                            DischargesDto? discharge = null;
                            if (admission.Discharges != null && admission.Discharges.Any())
                            {
                                discharge = admission.Discharges.FirstOrDefault();

                            }
                            <td>@discharge?.DischargeDate.ToString("dd-MM-yyyy")</td>
                            <td>@discharge?.DischargeTime.ToShortTimeString()</td>
                        }
                        <td align="center">
                            @if (DateTime.Now.IsWithin24Hours(admission.AdmissionDate))
                            {
                                <a class="btn btn-primary backBtn mx-1 mt-1" href="@Url.ActionLink("Edit", "Admissions", new {admissionId = admission.AdmissionID, patientId = admission.PatientID})"><span>Edit</span></a>
                            }

                            @if (admission.IsDischarged == false)
                            {
                                <div class="btn-group">
                                    <a class="btn btn-primary btn-sm mx-1 mt-1" href="@Url.ActionLink("ManageClient", "Clients", new {patientId = admission.PatientID})" style="white-space: nowrap; font-size : 15px;  text-align: center; line-height: 28px; border-radius: 4px;">Manage Client</a>
                                    <a class="btn btn-primary backBtn mx-1 mt-1" href="@Url.ActionLink("AdmissionDischargeCreate", "Admissions", new {admissionId = admission.AdmissionID})" style="white-space: nowrap; font-size : 15px; text-align: center; line-height: 28px; border-radius: 4px;">Discharge</a>
                                </div>
                            }

                            @if (admission.IsDischarged)
                            {
                                <a class="btn btn-primary backBtn mx-1 mt-1" href="@Url.ActionLink("AdmissionDischargeDetail", "Admissions", new {patientId = admission.PatientID, admissionId = admission.AdmissionID})"><span>Details</span></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mb-3">
            <a href="/Clients/ProfileSearch" class="btn btn-sm-back">Back</a>
        </div>

    </div>

    <!--Body content End-->
</div>
<!--Main container End-->
