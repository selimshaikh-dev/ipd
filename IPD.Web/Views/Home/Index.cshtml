@*@model UserDto
@{
    var drpFacilities = ViewBag.facilities;
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/media.css" asp-append-version="true" />
<!--Bootstrap icon cdn-->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">

<!--Essential JS cdn-Client side Validation-->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.1/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.css" />
 
<style>
    body {
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.42857143;
        color: #555555;
        background-color: #ffffff;
        font-weight: bold;
        margin: 0;
        /*overflow-y:scroll;*/
    }

    hr {
        opacity: 1;
    }

    element.style {
        padding-left: 20px;
        padding-right: 20px;
    }
    .toggle-password {
    float: right;
    cursor: pointer;
    margin-right: 10px;
    margin-top: -25px;
}
</style>

<body id="element" style="background-color:#0094ff; padding-top:40px;">
    <div style="width:90%; margin:auto;">
        <div class="row">
            <!--Main Content START-->
            <div class="col-md-6 col-lg-7" id="login1">
                <div class="text-center">
                    <h1 class="m-0 text-light h1Text" style="font-size:6rem" ;>
                        CMIS (IPD)
                        <small class="fw-bold" style="font-size:1rem;">Version 1.0.0</small>
                    </h1>
                    <hr style="height:2px; width:100%; border-width:0;" class="text-light">
                    <span style="font-size:32px; color:#ffffff;">Client Management Information System</span><br />
                    <span style="font-size:25px; color:#ffffff;">(Inpatient Department)</span>
                </div>
            </div>
            <!--Main Content END-->
            <!--Login START-->
            <div class=" col-md-6 col-lg-5">
                <form asp-action="Login" asp-controller="Home" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="card" style="margin-top:10px;">
                        <div class="card-body" style="padding-left:30px; padding-right:30px;">
                            <img src="/images/u3.svg" width="80" height="40" class="img-fluid mx-auto d-block">
                            <h1 class="text-center fw-bold fs-4">User Login</h1>
                            <hr>

                            <div class="form">
                                <!--Facility Name-->
                                <div class="form-group-lg">
                                    <label class="control-label" for="LoginFacilityID">Facility</label>
                                    <select class="form-select valid" id="LoginFacilityID" asp-for="FacilityId" style="max-width:100%;">
                                      
                                        @foreach (var ch in drpFacilities)
                                        {
                                            <option value="@ch.Value">@ch.Text</option>
                                        }
                                    </select>
                                    <span asp-validation-for="FacilityId" class="text-danger"></span>
                                </div>
                                <br>

                                <!--USER NAME-->
                                <div class="form-group-lg">
                                    <label class="control-label" for="Username">Username</label>
                                    <input asp-for="UserName" class="form-control text-box single-line valid" data-val="true" data-val-length="The field Username must be a string with a maximum length of 30." data-val-length-max="30" data-val-required="The Username is required!" id="Username" placeholder="Type username..." style="max-width:100%;" type="text">
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                </div>
                                <br>

                                <!--PASSWORD-->
                                <div class="form-group">
                                    <label class="control-label" for="password">Password</label>
                                    <input type="password" id="password" class="form-control" asp-for="Password">
                               
                                </div>
                             
                                <br>

                                <div class="form-group-lg">
                                    <button type="submit" class="btn py-2 w-100 fw-bold" style="font-size:17px; background-color:#2fa4e7; color:white;">
                                        <span class="bi bi-box-arrow-in-right"></span>&nbsp;&nbsp;Login
                                    </button>
                                    <br>
                                    <a href="/Users/Create" class="btn col-12 btn-lg btn-block mt-2" style="border-style: solid; border-color:#899094; font-size:16px;">
                                        <i class="bi bi-person-fill"></i> New User Registration
                                    </a>
                                </div><br>

                                <a href="/Home/ForgotPassword">Forgot password?</a>
                                <br>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <!--Login END-->
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.0.0-alpha1/js/bootstrap.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>
</body>

*@