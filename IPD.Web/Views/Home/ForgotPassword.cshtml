@using IPD.Domain.Dto
@model LoginRecoveryRequestsDto

@{
    ViewData["Title"] = "ClientRegistration";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<!--Main container Start-->
<div class="container">
    <div class="col-md-8 offset-md-2 text-center">
        <h1 class="text-center mt-2" style="font-size:38px;">Login Recovery Request</h1>
        <h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>
    <form asp-action="ForgotPassword" asp-controller="Home" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!--Password Recovery-->
        <div class="card mx-auto mt-3 col-md-8 offset-md-3">
            <div class="card-header text-secondary">
                Password Recovery
            </div>
            <!--Card-body START-->
            <div class="card-body pe-4 ">
                <h2 class="text-center" style="font-size:13px;">Please provide either Username or National ID along with the Cellphone number</h2>
                <fieldset>
                    <!--Username-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="UserName" class="col-md-3 text-end mt-3">Username</label>
                        <div class="col-md-9">
                            <input asp-for="UserName" type="text" class="form-control" placeholder="User Name">
                        </div>
                    </div>

                    <!--PIN-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="NationaliD" class="col-md-3 text-end mt-3">PIN</label>
                        <div class="col-md-9">
                            <input asp-for="NationaliD" type="text" class="form-control"
                                   data-val-length-max="13" data-val-required="PIN is required." id="txtIdentifire" maxlength="13"
                                   placeholder="Type PIN here.." title="The field PIN must be a number with a maximum length of 13." onkeypress="return onlyNumberKey(event)">
                        </div>

                    </div>

                    <!--Cellphone-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="CellPhone" class="col-md-3 text-end mt-3">Cellphone<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                            <input asp-for="CellPhone" type="text" class="form-control" onkeypress="return onlyNumberKey(event)" data-val-required="Cellphone is required." placeholder="Cellphone number">
                            <span asp-validation-for="CellPhone" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>
            </div>
            <!--card-body END-->
        </div>
        <!--Button START-->
        <div class="card mx-auto mt-4 col-md-8">
            <div class="card-body">
                <div class="text-center">
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary customBtn mt-3 mx-2" value="Create">
                            <span>Submit Recovery Request</span>
                        </button> &nbsp;
                        <a class="btn btn-big-back mt-3 mx-2" href="/"><span> Back</span></a>
                    </div><br />
                </div>
            </div>
        </div>
        <!--Button END-->
    </form>
</div>

<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

@section scripts{
<script>
        function onlyNumberKey(evt) {

        // Only ASCII character in that range allowed
        var ASCIICode = (evt.which) ? evt.which : evt.keyCode
        if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
            return false;
        return true;
    };

</script>
}
