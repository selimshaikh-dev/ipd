@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model List<PatientExaminationsDto>
@{
    ViewData["Title"] = "Examination";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var patientExaminations = ViewBag.DiagonosisExamimations as List<DiagonosisExaminationDto> ?? new List<DiagonosisExaminationDto>();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Examinations</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Navabr button-->
    <nav class="navbar navbar-light offset-md-1 mt-3">
        <form class="container justify-content-start">
            <a href="/ChiefComplaints/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Chief Complaint</a>
            <a href="/PatientExaminations/Index" class="btn btn-primary btnNav me-2 my-1" role="button">Examinations</a>
            <a href="/Diagnosis/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Diagnosis</a>
            <a href="/TreatmentPlan/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Treatment Plan</a>
            <a href="/MedicationPlan/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Medication Plan</a>
        </form>
    </nav>

    <!--Header-->
    <div class="col-md-10 offset-md-1 mt-3">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 offset-md-1 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-7 mt-2">
            @*<div class="responsive_div">*@
            <a href="@Url.ActionLink("Create", "PatientExaminations")" class="btn btn-primary btn-big fs-6"><span>Add New</span></a>

            @if (Model.Any())
            {
                @foreach (var examinations in Model)
                {
                    <div class="card mt-3 mb-3">
                        <div class="card-body pb-0">
                            <h6 style="color:#317eac;">Date Created: @examinations.DateCreated.Value.ToString("dd-MM-yyyy, hh:mm ttt")</h6>
                            <table class="table table-condensed table-responsive" style="font-size: 15px;">
                                <tbody>
                                    <tr>
                                        <td colspan="3" class="fs-5 text-secondary shadow-sm" style="background-color: rgba(0,0,0,.03);">
                                            <span>Patient Examinations</span>
                                            @if (DateTime.Now.IsWithin24Hours(examinations.DateCreated ?? DateTime.Now))
                                            {
                                                <span class="float-end">
                                                    <a href="@Url.ActionLink("Edit", "PatientExaminations", new { PatientExaminationID = examinations.PatientExaminationID })" class="btn btn-primary backBtn">Edit</a>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        @{
                                            var ExaminationIds = examinations.ExaminationDetails.Select(x => x.DigonosisExaminationID).ToList();
                                            var ExaminationDetails = patientExaminations
                                            .Where(x => ExaminationIds.Contains(x.DigonosisExaminationID))
                                            .ToList();
                                        }
                                        <th width="30%">Examination</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            @foreach (var Examination in ExaminationDetails)
                                            {
                                                <span>@Examination?.DigonosisExaminationsName</span> <br />
                                            }
                                        </td>
                                    </tr>

                                    <tr>
                                        <th width="30%" style="border: none;">Findings</th>
                                        <td width="3" style="border: none;">:</td>
                                        <td width="67%" style="border: none;">
                                            <span>@examinations.Findings</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <div>
                            </div>
                        </div>
                    </div>
                }
            }
            @*</div>*@
            <a href="/Clients/ManageClient?patientId=@ViewBag.ClientId" class="btn btn-sm-back mx-2"><span>Back</span></a>
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->