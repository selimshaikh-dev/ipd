@using IPD.Domain.Dto
@model SurgeriesDto
@{
    ViewBag.Title = "Surgery Detail";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
@{
    var surgeryTypes = ViewBag.SurgeryTypes as List<SurgeryTypeDto> ?? new List<SurgeryTypeDto>();
    var surgicalProcedures = ViewBag.SurgicalProcedures as List<SurgicalProceduresDto> ?? new List<SurgicalProceduresDto>();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Surgery Detail</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6">
            @*<div class="responsive_div">*@
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <table class="table">
                        <tbody>
                            <tr>
                                <td width="30%">Surgery date and time</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.SurgeryDate.ToString("dd-MM-yyyy"), @Model.SurgeryTime.ToShortTimeString()</td>
                            </tr>
                            <tr>
                                <td width="30%">Anesthetist assessment</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.AnaesthetistAssessment</td>
                            </tr>
                            <tr>
                                <td width="30%">Diagnosis</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Diagnosis</td>
                            </tr>
                            <tr>
                                <td width="30%">Has patients consent</td>
                                <td width="3%" align="center">:</td>
                                @if (Model.HasPatientsConcent == true)
                                {
                                <td width="67%">Yes</td>
                                }
                                else
                                {
                                <td width="67%">No</td>                                           
                                } 
                            </tr>
                            <tr>
                                <td width="30%">Procedure indication</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.ProcedureIndication</td>
                            </tr>
                            <tr>
                                <td width="30%">Surgery team</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.SurgeryTeam</td>
                            </tr>
                            <tr>
                                <td width="30%">Surgery type</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">
                                    @{
                                        var surgeryType = surgeryTypes.FirstOrDefault(x => x.SurgeryTypeID == Model.SurgeryTypeID);
                                    }
                                    @surgeryType?.TypeName
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Surgical procedure</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">
                                    @{
                                        var surgicalProcedure = surgicalProcedures.FirstOrDefault(x => x.SurgicalProcedureID == Model.SurgicalProcedureID);
                                    }
                                    @surgicalProcedure?.ProcedureName
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Other surgery type</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.OtherSurgeryType</td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-center">
                        <a class="btn btn-primary btn-big" href="@Url.ActionLink("Index", "Surgeries")">Finish</a>
                    </p>
                </div>
            </div>
            @*</div>*@
        </div>

        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
