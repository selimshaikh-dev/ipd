@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model System.Collections.Generic.List<SurgeriesDto>

@{
    ViewBag.Title = "Surgery List";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var surgeries = ViewBag.SurgeryTypes as List<SurgeryTypeDto> ?? new List<SurgeryTypeDto>();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12">
        <h1 class="text-center mt-3" style="font-size:36px; font-weight:700;">Surgery</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6 mt-2">
            <a href="@Url.ActionLink("Create", "Surgeries")" class="btn btn-primary btn-big mt-1 mb-2" style="text-align: center; line-height: 28px;"><span>Add New</span></a>

            @if (Model.Any())
            {
                @foreach (var surgery in Model)
                {
                    PostSurgeriesDto? postSurgery = null;
                    if (surgery.PostSurgeries != null && surgery.PostSurgeries.Any())
                    {
                        postSurgery = surgery.PostSurgeries.FirstOrDefault();
                    }
                    <div class="card mt-3 mb-3 table-responsive">
                        <div class="card-body pb-0">
                            <h6 style="color:#317eac;">Date Created : @surgery.SurgeryDate.ToString("dd-MM-yyyy, hh:mm ttt")</h6>

                            <table class="table" style="font-size: 15px;">
                                <tbody>
                                    <tr>
                                        <td colspan="4" class="fs-5 text-secondary shadow-sm" style="background-color: rgba(0,0,0,.03);">
                                            <span>Surgery</span>
                                            <span class="float-end">
                                                @if (DateTime.Now.IsWithin24Hours(surgery.SurgeryDate))
                                                {
                                                    <a class="btn btn-primary backBtn mx-2 mt-1 my-1 " href="@Url.ActionLink("Edit", "Surgeries", new {surgeryId = surgery.SurgeryID})" role="button" style="text-align: center; line-height: 28px;"><span>Edit</span></a>
                                                }
                                            </span>

                                           <span class="float-end">
                                                @if (postSurgery != null)
                                                {
                                                    <a class="backBtn btn btn-primary mx-2 mt-1 my-1 " href="@Url.ActionLink("SurgeryDetails", "Surgeries", new { surgeryId = surgery.SurgeryID })" style="text-align: center; line-height: 28px;"><span>Details</span></a>
                                                }
                                                else
                                                {
                                                    <a class="customBtn btn btn-primary mx-2 mt-1 my-1 " href="@Url.ActionLink("Create", "PostSurgeries", new { surgeryId = surgery.SurgeryID})" style="text-align: center; line-height: 28px;"><span>Post Surgery</span></a>
                                                }
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        @{
                                            var surgeryt = surgeries.FirstOrDefault(x => x.SurgeryTypeID == surgery.SurgeryTypeID);
                                        }
                                        <th width="30%">Surgery type</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgeryt?.TypeName</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th width="30%">Surgery date and time </th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgery.SurgeryDate.ToString("MMM dd, yyyy"), @surgery.SurgeryTime.ToShortTimeString()</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th width="30%">Anesthetist assessment</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgery.AnaesthetistAssessment</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th width="30%">Diagnosis</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgery.Diagnosis</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th width="30%">Procedure indication</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgery.ProcedureIndication</span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th width="30%">Surgery team</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgery.SurgeryTeam</span>
                                        </td>
                                    </tr>

                                    @*<tr>                                  
                                        <th width="30%">Surgical procedure</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@surgery.SurgicalProcedureID</span>
                                        </td>
                                    </tr>*@

                                    <tr>
                                        <th width="30%">Other surgery type</th>
                                        <td width="3">:</td>
                                         <td width="67%">
                                            <span>@surgery.OtherSurgeryType</span>
                                        </td>
                                    </tr>    
                                </tbody>
                            </table>
                            <div>
                            </div>
                        </div>
                    </div>
                }
            }

            <a href="/Clients/ManageClient?patientId=@ViewBag.ClientId" class="btn btn-sm-back mt-1 mb-2" style="text-align: center; line-height: 28px;"><span>Back</span></a>
        </div>

        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            <!--Latest Vitals-->
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
