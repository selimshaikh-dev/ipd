@using IPD.Domain.Dto
@using static IPD.Domain.Constants.Enumerators
@model PatientDto
@{
    ViewData["Title"] = "ClientDetails";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<style type="text/css">
    dt {
        margin-bottom: 20px;
    }
</style>

<h1 class="text-center text-primary pt-3">Client’s profile updated successfully.</h1>
<hr />
<div class="container" style="width:50%;">
    <div class="card">
        <div class="card-header">
            <dt>@Model</dt>
        </div>
        <div class="card-body">
            <dl class="dl-horizontal">
                <dt>Patient ID</dt>
                <dd>@Model.PatientID)</dd>

                <dt>First Name</dt>
                <dd>@Model.FirstName)</dd>

                <dt>Middle Name</dt>
                <dd>@Model.MiddleName)</dd>

                <dt>Last Name</dt>
                <dd>@Model.LastName)</dd>

                <dt>Sex</dt>
                <dd>@Model.Sex)</dd>

                <dt>Cellphone)</dt>
                <dd>
                    @Model.CellphoneCountryCode)
                    @Model.Cellphone)
                </dd>

                <dt>Email)</dt>
                <dd>@Model.Email)</dd>
            </dl>

            <p class="text-center">
                <a class="btn btn-primary customBtn" href="/Clients/ProfileSearch"><span> Back</span></a>
            </p>
        </div>
    </div>
</div>