@using IPD.Domain.Dto
@model PatientDto
@{
    ViewData["Title"] = "ClientRegistration";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<div class="col-md-10 text-center offset-1 mt-2">
    <h1 class="mb-2 fw-bold" style="font-size:30px;">Search Client</h1>
    @if (@Model.message != null)
    {
        <h3 class="mb-2 fw-bold" style="font-size:20px;color:red">You Can't Access Those Module</h3>
    }
    <hr class="mt-1" style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
</div>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <!--Main container Start-->
    <div class="container mt-4 mb-4" style="width:90%;">
        <div class="card mx-auto mt-2 col-md-7 offset-md-3">
            <!--Card-body START-->
            <div class="card-body pe-5">
                <div class="form-horizontal form-group">
                    <div class="col-md-12 me-3 ms-3">
                        <div class="row">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group mb-3 me-3 ms-3">
                                    <b><label class="mb-2">PIN / UHID / Cellphone</label></b>
                                    <input type="text" class="form-control" id="searchInput" maxlength="13" placeholder="Type here and click Search...">
                                </div>
                            </div>
                        </div>
                        <!--Button START-->
                        <div class="mx-auto col-md-12 mt-1">
                            <div class="text-center">
                                <div class="form-group fs-3">
                                    <a class="btn btn-primary btn-lg btn-block btn-search mt-1 mx-2" style="font-size:18px;" id="onSearchClick" onclick="onSearchClick()">
                                        <span>Search</span>
                                    </a>
                                    <a href="/Clients/AdvancedSearch" class="btn btn-primary btn-lg btn-block btn-search mt-1 mx-2" style="font-size:17px;">
                                        <span> Advanced Search</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <!--Button END-->
                    </div>
                </div>
            </div>
            <!--Card-body END-->
        </div>

        <!--No match found alert-->
        <div class="mx-auto col-md-10 offset-md-3">
            <div class="text-center mt-2" id="errorbox" style="display:none">
                <div class="alert" style="text-align:center;">
                    <h2 id="errText" style="color:red; font-weight:bold"></h2>
                </div>
                <div class="text-center">
                    <a href="/Clients/Create" id="registerBtn" class="btn btn-primary btn-lg btn-block btn-search" style="font-size:19px;">
                        Register profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@*<div class="col-md-10 text-center offset-1 mt-5">
    <hr class=" text-center mt-1" style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>*@

<div class=" col-md-10 offset-md-1" id="totalDiv">
</div>
<div id="base" class="mb-5">
    <div id="resultSection">
    </div>
</div>

@section scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js" integrity="sha512-AA1Bzp5Q0K1KanKKmvN/4d3IRKVlv9PYgwFPvm32nPO6QS8yH1HO7LbgB1pgiOxPtfeg5zEn2ba64MUcqJx6CA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script type="text/javascript">

           function formatDate(date) {
                var monthNames = [
                    "01", "02", "03",
                    "04", "05", "06", "07",
                    "08", "09", "10",
                    "11", "12"
                ];
                date = new Date(date);
                var day = date.getDate();
                var monthIndex = date.getMonth();
                var year = date.getFullYear();
                return year + '-' + monthNames[monthIndex] + '-' + day;
            }

        var input = document.getElementById("searchInput");
        input.addEventListener("keypress", function(event) {
      if (event.keyCode === 13) {
        event.preventDefault();
        document.getElementById("onSearchClick").click();
      }
    });

        function onSearchClick(){
            let errorText = ''
            let searchValue=$('#searchInput').val();
              if(searchValue.length == 0){ 
                 errorText = 'Nothing to search!' 
                 $('#errText').empty()               
                 $('#errText').append(errorText)
                 $('#registerBtn').hide()

            }else{
                 errorText = 'No match found!' 
                 $('#errText').empty()              
                 $('#errText').append(errorText)
                   $('#registerBtn').show()
            }
            $('#errorbox').hide();
                $('#resultSection').empty();
            let url = '';
           
            if(searchValue.length == 13){
                url = '@Model.baseUrl/Patients/GetPatientsByNID?nid='+searchValue;
            } else if(searchValue.length == 11){
                url = '@Model.baseUrl/Patients/GetPatientsByUHID?uhid='+searchValue;
            } else if(searchValue.length == 8){
                url = '@Model.baseUrl/Patients/GetPatientsByCellPhone?cellPhone='+searchValue;
            } else {
                $('#totalDiv').empty()
                $('#errorbox').show();
                return;
            }
            var registerLink = '/Clients/Create';
            if (searchValue.length == 13) {
                registerLink += '?pin=' + searchValue;
            }
            $.ajax({
            type: "GET",
            url: url,
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                //console.log(data);
                let total = data.length;
                var reg =`<div class="mx-auto col-md-10 offset-md-3 mb-5">
                                <div class="text-center">
                                    <div class="alert" style="text-align:center;">
                                        <h2 style="color:red; font-weight:bold">${errorText}</h2>
                                    </div>
                                    <div class="text-center">
                                        <a href="${registerLink}" class="btn btn-primary btn-lg btn-block btn-search" onclick="onSearchClick()" style="font-size:18px;">
                                            Register Profile
                                        </a>
                                    </div>
                                </div>
                            </div>`

                $('#resultSection').empty();
                if(data.length == 0){
                        $('#totalDiv').empty()
                        $('#resultSection').append(reg);
                } else {

                $(data).each(function(index,i){
                        let dob = moment(i.dob).format("DD-MM-yyyy");

                        let middle=i.middleName;
                        let maritalstatus = '';
                        let gender= '';
                        let email = '';
                        let cheafdom = '';
                        let tenkundula='';
                        let landPhone='';
                        let postalAddress='';
                        if(i.postalAddress != null){
                        postalAddress = i.postalAddress
                        }
                        else{
                        postalAddress = ''
                        }
                        if(i.email != null){
                        email = i.email
                        }
                        else{
                        email = ''
                        }
                        if(i.chiefdoms != null){
                        cheafdom = i.chiefdoms.name
                        }
                        if(i.chiefdoms.tinkhundla != null){
                        tenkundula = i.chiefdoms.tinkhundla.name
                        }

                        if(i.sex == 1){
                        gender = 'Male';
                        }
                        else if(i.sex ==2)  {
                                gender = 'Female';
                        }
                        else if(i.sex ==3){
                            gender = 'Unknown'
                        }
                        else{
                            gender= '';
                        }
                        if(i.maritalStatus == 1){
                        maritalstatus = 'Single';
                        }
                        else if(i.maritalStatus ==2)  {
                                maritalstatus = 'Married';
                        }
                        else if(i.maritalStatus ==3)  {
                                maritalstatus = 'Widowed';
                        }
                        else if(i.maritalStatus ==4)  {
                                maritalstatus = 'Divorced';
                        }
                        else if(i.maritalStatus ==5)  {
                                maritalstatus = 'Separated';
                        }
                        else{
                                maritalstatus = '';
                        }
                        if(middle == null){
                        middle ='';
                        }
                             if(i.landPhone != null){
                        landPhone = i.landPhone
                        }

            var r = `<div class="card mx-auto mb-4 mt-3 col-md-10 offset-md-3">

            <div class="card-body pe-4 mb-1">
            <div class="form-horizontal form-group">
                <div class="col-md-12 me-1 ms-1">
                   <div class="customdiv" style="margin-left: 12px;">
                    <div class="d-flex justify-content-between ms-1 me-3">

                    <div class="fs-5 fw-bold" style="color:#317eac;">
                        ${i.firstName} ${middle} ${i.lastName}
                    </div>

                    <div style="color:#317eac;">Profile registered: ${formatDate(i.dateCreated)}</div>
                    </div>

                    <div class="fs-6 me-2 ms-1" style="font-weight:400; color:#317eac;">
                            UHID: ${i.uhid}
                    </div>
                   </div>
                <div class="table-responsive py-2 me-3 ms-3">
                    <table class="table table-bordered table-responsive">
                      <tbody>
                        <tr>
                          <th scope="row">PIN</th>
                           <td>${i.nationalID}</td>
                          <td style="font-weight:bold;">Date of birth</td>
                          <td> ${dob}</td>
                          <td style="font-weight:bold;"> Sex</td>
                          <td> ${gender}</td>
                        </tr>

                        <tr>
                          <th scope="row">Cellphone</th>
                          <td>${i.cellphone}</td>
                          <th scope="row">Land phone</th>
                          <td>${landPhone}</td>
                          <td style="font-weight:bold;">Email</td>
                          <td>${email}</td>
                        </tr>

                        <tr>
                        <td style="font-weight:bold;">Country of origin</td>
                          <td>${i.countries.name}</td>
                        <td style="font-weight:bold;">Inkhundla</td>
                          <td>${tenkundula} </td>
                          <td style="font-weight:bold;">Chiefdom</td>
                          <td>${cheafdom} </td>

                        </tr>

                        <tr>
                          <th scope="row">Marital Status</th>
                           <td>${maritalstatus}</td>
                          <td style="font-weight:bold;">Residential address</td>
                          <td>${i.contactAddress}</td>
                          <th style="font-weight:bold;">Postal address</th>
                          <td>${postalAddress} </td>
                        </tr>

                      </tbody>
                    </table>
                </div>

                <div class="mx-auto col-md-10">
                    <div class="text-center">
                        <div class="form-group fs-3">
                            <a href="/Clients/Edit?patientId=${i.patientID}" class="btn btn-primary btn-block btn-search mx-2 my-1" style="font-size:18px;">
                                 Edit Profile
                            </a>
                            <a href="/Admissions?patientId=${i.patientID}" class="btn btn-primary btn-block btn-search mx-2 my-1" style="font-size:18px;">
                                 Select
                            </a>
                        </div>
                    </div>
                </div>
                </div>
                </div>
            </div>
        </div>`;
        $('#resultSection').append(r);
        $('#errorbox').hide();

        });
         $('#totalDiv').empty()
         $('#totalDiv').append(`<div class="text-center">Total Record(s) Found in CMIS: ${total}</div>`)
        }

        },

        failure: function (data) {

        $('#resultSection').append(reg);
        console.log(data);
        },
        error: function (data) {

              var reg =`<div class="mx-auto col-md-10 offset-md-3">
                                <div class="text-center">
                                    <div class="alert" style="text-align:center;">
                                        <h2 style="color:red; font-weight:bold">${errorText}</h2>
                                    </div>
                                    <div class="text-center">
                                        <a href="${registerLink}" class="btn btn-primary btn-lg btn-block btn-search" onclick="onSearchClick()" style="font-size:19px;">
                                            Register Profile
                                        </a>
                                    </div>
                                </div>
                            </div>`
                             $('#totalDiv').empty()
       $('#resultSection').append(reg);
        console.log(data);
        }

        });
        }

</script>
}
