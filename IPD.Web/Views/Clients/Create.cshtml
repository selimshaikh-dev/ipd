@using static IPD.Domain.Constants.Enumerators
@using IPD.Domain.Dto
 @model PatientDto
@{
    ViewData["Title"] = "ClientRegistration";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var drpcountry = ViewBag.country;
    var drpInkhundla = ViewBag.inkhundla as List<Tinkhundla> ?? new List<Tinkhundla>();
    var drpChiefdom = ViewBag.chiefdom as List<Chiefdom> ?? new List<Chiefdom>();
    var baseUrl = Model?.baseUrl ?? "";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>
<br />
<h1 class="text-center text-capitalize" style="font-size:36px;">New Client Registration</h1>
<h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>

<!--Main container Start-->
<div class="container">
    <!--Body content Start-->
    <form asp-action="Create" name="ClientsEditForm" asp-controller="Clients" method="post" onsubmit="return validateForm()">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <!--Client identification-->
        <div class="card mx-auto mt-4 col-md-10 offset-md-3">
            <div class="card-header text-secondary">
                Client Identification
            </div>
            <!--Card-body START-->
            <div class="card-body pe-5">
                <div class="form-horizontal form-group row">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="pb-3">
                                <input checked="checked" id="optPIN" name="SearchOption" type="radio" onclick="Anable()" value="PIN"> PIN&nbsp;
                                <input id="optCode9" name="SearchOption" type="radio" onclick="Disable()" value="Code9"> Code9&nbsp;
                                <input id="optCode1" name="SearchOption" type="radio" value="Code1"> Code1
                            </div>
                        </div>

                        <!--National ID-->
                        <div class="row ">
                            <div class="col-md-8 mt-2">
                                <input asp-for="NationalID" class="form-control text-box single-line"
                                       data-val-length-max="13" data-val-required="PIN is required!" maxlength="13"
                                       placeholder="Type client's PIN and click Search..." style="max-width:600px; height: 38px;" id="txtIdentifire" type="text" title="The field PIN must be a number with a maximum length of 13." onkeypress="return onlyNumberKey(event)">
                                <span asp-validation-for="NationalID" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mt-2">
                                <button type="button" id="btnSearch" value="Search" class="btn btn-primary customBtn" onclick="searchByPin()">
                                    <span>Search</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5" style="padding-top:5px; font-size:13px;">
                        Use <b>Personal Identification Number (PIN)</b> to search client's details.
                        <br>
                        Use <b>Code 9</b> for Swazi citizen who does not have the Swazi PIN.
                        <br>
                        Use <b>Code 1</b> for foreign citizen who does not have the Swazi PIN.
                    </div>
                </div>
            </div>
            <!--Card-body END-->
        </div>

        <!--Personal Details-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-header text-secondary">
                Personal Details
            </div>
            <!--Card-body START-->
            <div class="card-body pe-4">
                <div class="form-horizontal">
                    <fieldset>
                        <!--Firstname-->
                        <div class="form-group row mb-3 me-4 ms-4">
                            <label asp-for="FirstName" class="col-md-3 text-end mt-3">First name<span class="text-danger" style="font-size: 14px;"> *</span></label>
                            <div class="col-md-9">
                                <input asp-for="FirstName" id="txtFirstName" type="text" class="form-control" data-val-length-max="30" data-val-required="The first name is required." placeholder="Enter first name" onkeydown="return /[a-z]/i.test(event.key)">
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                        </div>

                        <!--Middle name-->
                        <div class="form-group row mb-3 me-4 ms-4">
                            <label asp-for="MiddleName" class="col-md-3 text-end mt-3">Middle name</label>
                            <div class="col-md-9">
                                <input asp-for="MiddleName" id="txtMiddleName" type="text" class="form-control" data-val="true" data-val-length-max="30" placeholder="Enter middle name" onkeydown="return /[a-z]/i.test(event.key)">
                            </div>
                        </div>

                        <!--Last name-->
                        <div class="form-group row mb-3 me-4 ms-4">
                            <label asp-for="LastName" class="col-md-3 text-end mt-3">Last name<span class="text-danger" style="font-size: 14px;"> *</span></label>
                            <div class="col-md-9">
                                <input asp-for="LastName" id="txtLastName" type="text" class="form-control" data-val-length-max="30" data-val-required="The last name is required." placeholder="Enter last name" onkeydown="return /[a-z]/i.test(event.key)">
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <!--Date of birth-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label for="DOB" class="col-md-3 text-end mt-3">Date of birth<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                            <div class="input-group mb-3">
                                <input name="dateOfBirth" id="dob" type="hidden" />
                                <input name="Sex" id="gender" type="hidden" />
                                <input asp-for="DOB" id="datepicker" readonly="true" value="" class="form-control datepicker" data-val-required="Date of birth is required." type="text" />
                                <span class=" input-group-text " id="btnPicker">
                                    <span class="bi bi-calendar"></span>
                                </span>
                            </div>
                            <span asp-validation-for="DOB" class="text-danger"></span>
                        </div>
                    </div>

                        <!--Sex-->
                        <div class="form-group row mb-3 me-4 ms-4">
                            <label asp-for="Sex" class="col-md-3 text-end mt-3">Sex<span class="text-danger" style="font-size:14px;"> *</span></label>
                            <div class="col-md-9">
                            <select asp-for="Sex" asp-items="Html.GetEnumSelectList(typeof (Sex))" class="form-select" id="sex">
                                <option value="">Select</option>
                            </select>
                            <span asp-validation-for="Sex" class="text-danger"></span>
                        </div>
                        </div>

                        <!--Maritual status-->
                        <div class="form-group row mb-3 me-4 ms-4">
                            <label asp-for="MaritalStatus" class="col-md-3 text-end mt-3">Marital status<span class="text-danger" style="font-size:14px;"> *</span></label>
                            <div class="col-md-9">
                                <select asp-for="MaritalStatus" asp-items="Html.GetEnumSelectList(typeof(MaritalStatuses))" class="form-select" id="maritualStatus">
                                    <option value="">Select</option>
                                </select>
                                <span asp-validation-for="MaritalStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <!--Country of origin-->
                        <div class="form-group row mb-3 me-4 ms-4">
                            <label asp-for="CountryID" class="col-md-3 text-end mt-3">Country of origin<span class="text-danger" style="font-size:14px;"> *</span></label>
                            <div class="col-md-9">
                                <select asp-for="CountryID" class="form-select" id="CountryID">
                                    @foreach (var item in drpcountry)
                                    {
                                        <option value="@item.CountryID">@item.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="CountryID" class="text-danger"></span>
                            </div>
                        </div>
                    </fieldset>
                </div>

            </div>
            <!--card-body END-->
        </div>

        <!--Address and Contact Information-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-header text-secondary">
                Address and Contact Information
            </div>
            <!--Card body start-->
            <div class="card-body">

                <!--Contact address-->
                <div class="form-group row mb-3 me-4 ms-4">
                    <label asp-for="ContactAddress" class="col-md-3 text-end mt-4">Residential address<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <textarea asp-for="ContactAddress" class="form-control text-box multi-line" id="ContactAddress" rows="3" data-val="true" data-val-required="The Contact address is required." data-val-length="The field Contact address must be a string with a maximum length of 500." data-val-length-max="500" maxlength="500"></textarea>
                        <span asp-validation-for="ContactAddress" id="ContactAddressError" class="text-danger"></span>
                    </div>
                </div>

                <!--Inkhundla-->
                <div class="form-group row mb-3 me-4 ms-4">
                    <label asp-for="TinkhundlaID" class="col-md-3 text-end mt-3">Inkhundla<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <select asp-for="TinkhundlaID" class="form-select" id="ddlInkhundla" data-validation-for="Tinkhundla name is required!" onchange="onddlInkhundlachange()">
                            <option value="">Select</option>
                            @foreach (var item in drpInkhundla)
                            {
                               <option value="@item.TinkhundlaID">@item.Name</option>
                            }
                        </select>
                        <span asp-validation-for="TinkhundlaID" class="text-danger"></span>
                    </div>
                </div>

                <!--Chiefdom-->
                <div class="form-group row mb-3 me-4 ms-4">
                    <label asp-for="ChiefdomID" class="col-md-3 text-end mt-3">Chiefdom<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <select asp-for="ChiefdomID" class="form-select" data-validation-for="Chiefdom name is required!" id="ddlChiefdomID">
                            <option value="">Select</option>
                            @foreach (var item in drpChiefdom)
                            {
                               <option value="@item.ChiefdomID">@item.Name</option>
                            }
                        </select>
                        <span asp-validation-for="ChiefdomID" class="text-danger"></span>
                    </div>
                </div>

                <!--Postal Address-->
                <div class="form-group row mb-3 me-4 ms-4">
                    <label asp-for="PostalAddress" class="col-md-3 text-end mt-4">Postal address</label>
                    <div class="col-md-9">
                        <textarea asp-for="PostalAddress" class="form-control text-box multi-line" rows="3" data-val="true" data-val-length="The field Postal address must be a string with a maximum length of 500." data-val-length-max="500" maxlength="500"></textarea>
                    </div>
                </div>

                <div class="form-group row mb-3 me-4 ms-4">
                    <label class="control-label col-md-3 text-end mt-3" for="Cellphone">Cellphone<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <!--CountryCode-->
                    <div class="col-md-3">
                        <input asp-for="CellphoneCountryCode" class="form-control text-box single-line my-1" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val-length="Cellphone country code should be atleast 3 digits" data-val-required="Country code is required." data-val-length-min="3" maxlength="3" placeholder="Country code" title="The field Country code must be a number with a maximum length of 3." type="text">
                        <span asp-validation-for="CellphoneCountryCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <input class="form-control text-box single-line" asp-for="Cellphone" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val="true" data-val-length="Cellphone should be atleast 8 digits" data-val-length-max="15" data-val-length-min="8" data-val-required="Cellphone is required!" id="txtCellphone" maxlength="15" placeholder="Cellphone number" title="Cellphone should be atleast 8 digits." type="text">
                        <span asp-validation-for="Cellphone" class="text-danger"></span>
                    </div>
                </div>

                <!--Land phone-->
                <div class="form-group row mb-3 me-4 ms-4">
                    <label class="control-label col-md-3 text-end mt-3" for="Cellphone">Land phone</label>
                    <div class="col-md-3">
                        <input asp-for="LandPhoneCountryCode" class="form-control text-box single-line my-1" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val="true" data-val-length-max="3" maxlength="3" placeholder="Country code" title="The field Land phone must be a number with a maximum length of 3." type="text">
                    </div>
                    <div class="col-md-6">
                        <input asp-for="LandPhone" class="form-control text-box single-line my-1" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val-length-max="15" data-val="true" maxlength="15" placeholder="Land phone number" title="Landphone should be atleast 8 digits." type="text">
                    </div>
                </div>

                <!--Email Address-->
                <div class="form-group row mb-3 me-4 ms-4">
                    <label for="Email" class="col-md-3 text-end mt-3">Email address</label>
                    <div class="col-md-9">
                        <input asp-for="Email" type="email" class="form-control" data-val="true" data-val-length-max="60" aria-describedby="emailHelp">
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <!--Card body END-->
        </div>

        <!--Button START-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-body">
                <div class="text-center">
                    <div class="form-group fs-3">
                        <button class="btn btn-primary btn-big mt-3 mx-2" value="Create" type="submit">
                            <span>Save</span>
                        </button>
                        <a class="btn btn-big-back mt-3 mx-2" href="/Clients/ProfileSearch"><span> Back</span></a>
                    </div>
                </div>
            </div>
        </div>
        <!--Button END-->
    </form>
</div>


@section scripts {
<script type="text/javascript">
    $(document).ready(function () {
         $("#optPIN").attr("checked", true);
            //$("#txtIdentifire").val('');
             $("#txtIdentifire").val();
             $('#btnSearch').trigger('click');
            $("#userValidation").hide();
            addReadonlyAttr();
            ClearDemographics();
            DisableDemographics();

            $("#ddlChiefdomID").html("<option value=\"\">Select</option>");
            $('[data-toggle="tooltip"]').tooltip();
            $("#btnSave").click(function () {
              alert($('#sex').val())
              return false;
                if (!$("#frmClientProfile").valid()) {
                bootbox.alert("One or more required fields are empty! Please review your entry before saving.");
                return false;
            }

            if ($("#ddlMaritalStatus").val() == 0) {
                bootbox.alert("Marital status is required!");
                return false;
            }

            if ($("#ddlNationality").val() == 0) {
                bootbox.alert("Nationality is required!");
                return false;
            }

            if ($("#ddlInkhundla").val() == 0) {
                bootbox.alert("Inkhundla is required!");
                return false;
            }

            if ($("#ddlChiefdomID").val() == null || $("#ddlChiefdomID").val() == 0) {
                bootbox.alert("Chiefdom is required!");
                return false;
            }
        });

        //MAPPING RELAVANT CHIEFDOMS TO INKHUNDLA
        $("#ddlInkhundla").change(function () {
            $("#ddlChiefdomID").empty();
            console.log($("#ddlInkhundla").val());
            $.ajax({
                url:  '@baseUrl/Chiefdoms/LoadChiefdom',
                //url:  'https://localhost:5055/api/Chiefdoms/LoadChiefdom',

                dataType: "json",

                type: "GET",

                data: { InkhundlaID : $("#ddlInkhundla").val() },

                success: function (data) {
                    var items = "";
                    items = "<option value=\"\">Select</option>";
                    $.each(data, function (i, item) {
                        items += "<option value=\"" + item.chiefdomID + "\">" + item.name + "</option>";
                    });

                    $("#ddlChiefdomID").html(items);
                }
            });
        });

        //DISABLING NON-NUMERIC CHARACTER INPUT FOR COUNTRY CODE AND CELL/LANDPHONE
        $("#txtIdentifire, #txtCellphoneCountryCode, #txtCellphone, #txtLandPhoneCountryCode, #txtLandPhone").bind("keypress", function (e) {
            var characterCode = (e.which) ? e.which : e.keyCode;

            if (characterCode == 8 || characterCode == 9 || characterCode == 37 || characterCode == 39)
                return true;

            if (characterCode < 48 || characterCode > 57)
                return false;

            return true;
        });

         //Disabling input for demographics if pin is supplied
            $("#optPIN").click(function () {
                $("#txtIdentifire").val('');
                addReadonlyAttr();
                ClearDemographics();
                DisableDemographics();
            });

    });
        function removeReadonlyAttr()
                  {
                   $('#txtFirstName').attr('readonly',false);
                   $('#txtMiddleName').attr('readonly',false);
                   $('#txtLastName').attr('readonly',false);
                   $('#datepicker').attr('readonly',false);
                   $('#sex').attr('readonly',false,);
                   $('#sex').attr('disabled',false);
                   $('#datepicker').attr("disabled", false);
                   $('#gender').attr('disabled', true);
                  }
         function addReadonlyAttr()
                  {
                    $('#txtFirstName').attr('readonly',true);
                    $('#txtFirstName').attr('readonly',true);
                    $('#txtMiddleName').attr('readonly',true);
                    $('#txtLastName').attr('readonly',true);
                    $('#datepicker').attr('readonly',true);
                    $('#sex').attr("disabled", true);
                    $('#datepicker').attr("disabled", true);
                    $('#gender').attr('disabled', false);
                  }
         function DisableDemographics()
        {
            $("#txtFirstName").bind("keypress, keydown", false)
            $("#txtMiddleName").bind("keypress, keydown", false);
            $("#txtLastName").bind("keypress, keydown", false);
            $("#txtDOB").bind("keypress, keydown", false);
        }
        //function EnableDemographics()
        //{
        //    $("#txtFirstName").val("").unbind("keypress, keydown")
        //    $("#txtMiddleName").val("").unbind("keypress, keydown");
        //    $("#txtLastName").val("").unbind("keypress, keydown");
        //    $("#txtDOB").val("").unbind("keypress, keydown");
        //}

        
        function enadbleTextMode(){
                $("#txtFirstName").val("").unbind("keypress, keydown")
                $("#txtMiddleName").val("").unbind("keypress, keydown");
                $("#txtLastName").val("").unbind("keypress, keydown");
                $("#txtDOB").val("").unbind("keypress, keydown");
         }

        function ClearDemographics()
        {
            $("#txtFirstName").val("")
            $("#txtMiddleName").val("")
            $("#txtLastName").val("")
            $("#txtDOB").val("")
            $("#ddlSex").val("")
        }
          $('#optCode9').click(function(){
                $('#txtIdentifire').val('');
                $('#txtIdentifire').val(9999999999999);
                enadbleTextMode();
                removeReadonlyAttr();
            });

         $("#optCode1").click(function () {
                $('#txtIdentifire').val();
                $('#txtIdentifire').val(1111111111111);
                enadbleTextMode();
                removeReadonlyAttr();
            });


    function onlyAlphabets(e, t) {

        if (window.event) {
            var charCode = window.event.keyCode;
        }
        else if (e) {
            var charCode = e.which;
        }
        else { return true; }

        if (charCode == 8 || charCode == 9 || charCode == 32 || charCode == 37 || charCode == 39)
            return true;

        if ((charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123))
            return true;
        else
            return false;
    }
    function onddlInkhundlachange(){
        $("#ddlChiefdomID").empty();
            console.log($("#ddlInkhundla").val());
            $.ajax({
                url: '@baseUrl/Chiefdoms/LoadChiefdom',

                dataType: "json",

                type: "GET",

                data: { InkhundlaID: $("#ddlInkhundla").val() },

                success: function (data) {
                    console.log(data);
                    var items = "";
                    items = "<option value=\"\">Select</option>";
                    $.each(data, function (i, item) {
                        items += "<option value=\"" + item.chiefdomID + "\">" + item.name + "</option>";
                    });

                    $("#ddlChiefdomID").html(items);
                }
            });
    }
</script>

<!--- For datetimepicker -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<script type="text/javascript">
    $(function () {
              $("#datepicker").datepicker({
                  dateFormat: 'yy-mm-dd',
                  showButtonPanel: true,
                  changeMonth: true,
                  changeYear: true,
                  yearRange: '1900:2022',
                  inline: true,
                  maxDate: 0
              });

          });
          $("#btnPicker").click(function () {

          $("#datepicker").focus();
          });

      //Phone number validation
      function onlyNumberKey(evt) {

          // Only ASCII character in that range allowed
          let ASCIICode = (evt.which) ? evt.which : evt.keyCode
          if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
              return false;
          return true;
      };

       function alphaOnly(event) {
        var key = event.keyCode;
        return ((key >= 65 && key <= 90) || key == 8);
      };

      function searchByPin(){
          const checkedPin = $('#optPIN').attr('checked');
          console.log(checkedPin);
          if(checkedPin){
           const pin = $('#txtIdentifire').val();
              //document.getElementById("#txtIdentifire").innerHTML = $('#txtIdentifire').val();
           $.ajax({
                  url: "@baseUrl/Patients/PinSearchDapper?Pin="+pin,

                  dataType: "json",

                  type: "GET",

                  success: function (data) {

                      $('#sex').attr('disabled', true);
                      $('#gender').attr('disabled', false);

                      $('#txtFirstName').val(data[0].firstName);

                      $('#txtMiddleName').val(data[0].middleName);
                      $('#txtLastName').val(data[0].lastName);
                      $('#datepicker').val(convertDateMMddyyyy(data[0].dob));
                      $('#dob').val(convertDateMMddyyyy(data[0].dob));
                      $('#sex').val(data[0].sex);
                      $('#gender').val(data[0].sex);
                      addReadonlyAttr()
                      console.log(data);
                  }
           });
          }
      }
</script>
}

 <script>
       //Textare input field validation
        function validateForm() {
          let a = document.forms["ClientsEditForm"]["ContactAddress"].value;
         
            if (a == "") {
                document.getElementById("ContactAddressError").innerHTML = "The Residential Address is required!";
                return false;
            } else {
                document.getElementById("ContactAddressError").innerHTML = " ";
            }
        }
</script>