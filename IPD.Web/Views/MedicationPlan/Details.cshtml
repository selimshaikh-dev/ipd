@using IPD.Domain.Dto
@model PrescriptionDetailsDto

@{
    ViewData["Title"] = "Diagnosis";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var MedicationPlanList = ViewBag.MedicationList as List<MedicationDto> ?? new List<MedicationDto>();
    var IntervalList = ViewBag.IntervalList as List<IntervalDto> ?? new List<IntervalDto>();
    var DirectionList = ViewBag.DirectionList as List<DirectionDto> ?? new List<DirectionDto>();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Medication Plan</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="col-md-10 offset-md-1 mt-3">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 offset-md-1 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-7 mt-1">
            @*<div class="responsive_div">*@
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <div class="card mt-3 mb-3">
                        <div class="card-body pb-0">
                            <h6 style="color:#317eac;">Doctor name:@Model.DoctorName</h6>
                            <h6 style="color:#317eac;" align="left">Prescription date:@Model.PrescriptionsDate</h6>
                            <table class="table table-condensed table-responsive">
                                <tbody>
                                    <tr style="border-color:black">
                                        <td colspan="5" class="fs-5 text-secondary shadow-sm" style="background-color: rgba(0,0,0,.03);">
                                            <span>Medication Plan</span>
                                        </td>
                                    </tr>
                                    <tr style="border-color:black;">
                                        <th>Medication</th>
                                        <th>Dose</th>
                                        <th>Interval</th>
                                        <th>Duration</th>
                                        <th>Direction</th>
                                    </tr>
                                    @foreach (var item in Model.MedicationPlans)
                                    {
                                        <tr>
                                            <td>@item.Medications</td>
                                            <td>@item.Dose</td>
                                            <td>@item.Intervals</td>
                                            <td>@item.Durations</td>
                                            <td>@item.Directions</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <p class="text-center mb-2">
                        <a class="btn btn-primary btn-big mt-3" href="/MedicationPlan/Index">Finish</a>
                    </p>
                </div>
            </div>
            @*</div>*@
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->