@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model List<PrescriptionDetailsDto>
@{
    ViewData["Title"] = "Clinical Assessment";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Medication Plan</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Navabr button-->
    <nav class="navbar navbar-light offset-md-1 mt-3">
        <form class="container-fluid justify-content-start">
            <a href="/ChiefComplaints/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Chief Complaint</a>
            <a href="/PatientExaminations/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Examinations</a>
            <a href="/Diagnosis/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Diagnosis</a>
            <a href="/TreatmentPlan/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Treatment Plan</a>
            <a href="/MedicationPlan/Index" class="btn btn-primary btnNav me-2 my-1" role="button">Medication Plan</a>
        </form>
    </nav>
    <!--Header-->
    <div class="col-md-10 offset-md-1 mt-3">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 offset-md-1 mt-1">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-7 mt-1">
            <a href="/MedicationPlan/Create" class="btn btn-primary btn-big fs-6"><span>Add New</span></a>

            @foreach (var medication in Model)
            {
                <div class="card mt-3 mb-3" style="overflow-x: hidden; max-width: 100%;">
                    <div class="card-body table-responsive pb-0">
                        
                        <table class="table table-condensed" style="font-size: 14px;">
                            <tbody>
                                <tr style="border-color:black">
                                    <td colspan="5" class="fs-5 text-secondary shadow-sm" style="background-color: rgba(0,0,0,.03);">
                                        <span style="font-size:20px;">Medication Plan</span>
                                        @if (DateTime.Now.IsWithin24Hours(medication.PrescriptionsDate))
                                        {
                                            <span class="float-end">
                                                <a href="@Url.ActionLink("Edit", "MedicationPlan", new { prescriptionId = medication.PrescriptionsID})" class="btn btn-primary backBtn"> Edit</a>
                                            </span>
                                        }
                                    </td>
                                </tr>
                                <tr style="border-color:black">
                                    <th>Medication</th>
                                    <th>Dose</th>
                                    <th>Interval</th>
                                    <th>Duration</th>
                                    <th>Direction</th>
                                </tr>
                                @foreach (var item in medication.MedicationPlans)
                                {
                                    <tr>
                                        <td>@item.Medications</td>
                                        <td>@item.Dose</td>
                                        <td>@item.Intervals</td>
                                        <td>@item.Durations</td>
                                        <td>@item.Directions</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            <a href="/Clients/ManageClient?patientId=@ViewBag.ClientId" class="btn btn-sm-back"><span>Back</span></a>
        </div>
    </div>
</div>
<!--Main container End-->