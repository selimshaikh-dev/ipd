@model MedicationsPlanDto
@using IPD.Domain.Dto
@using IPD.Web.Extensions;
@{
    ViewData["Title"] = "Medication plan";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var latestChiefComplain = ViewBag.ChiefComplain as ChiefComplaintsDto;
    var latestPatientDiagnosis = ViewBag.PatientDiagnosis as PatientDiagnosisDto;
    var latestTreatmentPlan = ViewBag.TreatmentPlan as TreatmentPlanDto;
    var latestExamination = ViewBag.Examination as PatientExaminationsDto;
    var admission = ViewBag.Admission as AdmissionsDto ?? new AdmissionsDto();
}

<!--Custom CSS-->
<link rel="stylesheet" href="https://parsleyjs.org/src/parsley.css" />
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/css/select2.min.css" asp-append-version="true" />
<style>
    /*Parsly  Section*/
    input.parsley-success,
    select.parsley-success,
    textarea.parsley-success {
        color: #468847;
        background-color: #DFF0D8;
        border: 1px solid #D6E9C6;
    }

    input.parsley-error,
    select.parsley-error,
    textarea.parsley-error {
        color: #B94A48;
        background-color: #F2DEDE;
        border: 1px solid #EED3D7;
    }
    .parsley-errors-list {
        margin: 2px 0 3px;
        padding: 0;
        list-style-type: none;
        font-size: 0.9em;
        line-height: 0.9em;
        opacity: 0;
        transition: all .3s ease-in;
        -o-transition: all .3s ease-in;
        -moz-transition: all .3s ease-in;
        -webkit-transition: all .3s ease-in;
    }

        .parsley-errors-list.filled {
            opacity: 1;
        }

    .parsley-type, .parsley-required, .parsley-equalto {
        color: #ff0000;
    }
</style>
<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px;font-weight:700">Medication Plan</h1>
        <h5 style="font-weight:600">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>
        <hr class="mt-4" style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->

    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 col-sm-3 col-lg-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <!--Medication Plan-->
        <div class="col-sm-9 col-md-9 col-lg-9 mt-2">
            <div class="card">
                <div class="card-body pe-2">
                    <fieldset>
                        <div class="form-group mb-3 me-0 ms-0 row">
                            <label asp-for="@admission.AssaignDoctor" class="col-md-3 text-end mt-3">Doctor name<span class="text-danger" style="font-size: 14px;"> *</span></label>
                            <div class="col-md-8 justify-content-sm-center">
                                <input asp-for="@admission!.AssaignDoctor" name="DoctorName" class="form-control" id="doctorName" type="text" value="@admission.AssaignDoctor">
                                <span asp-validation-for="@admission!.AssaignDoctor" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="text-center mb-3">
                            <a href="javascript:void(0)" class="btn btn-primary backBtn mx-2" id="toggle">Next</a>
                        </div>
                    </fieldset>
                </div>
            </div>

            <div class="card mx-auto mt-2" id="third">
                <div class="card-header text-secondary d-flex justify-content-between">
                    <span> Medication plan</span>
                    <button type="button" id="addNew" title="Add Row" class="btn btn-primary backBtn mt-1 mx-2"><i class="bi bi-plus"></i></button>
                </div>
                <!--Card-body START-->

                <form class="user-registration" asp-controller="MedicationPlan" asp-action="Create" method="post" data-parsley-validate="">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input asp-for="@admission!.AssaignDoctor" name="DoctorName" id="doctorName1" type="hidden">

                    <div id="divCont">
                        <div class="row m-4 border mt-3">
                            <div class="col-sm-4 col-md-9 col-lg-9 mt-2">
                                <div class="form-group mb-3 ms-4">
                                    <label asp-for="MedicationsID">Medications<span class="text-danger" style="font-size: 14px;">*</span></label>
                                    <select name="MedicationsID" required class="form-select">
                                        <option selected value="">Select</option>
                                        @foreach (var item in Model.medicationDtos)
                                        {
                                            <option value="@item.MedicationID">@item.MedicationName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-3 col-lg-3 mt-2">
                                <div class="form-group mb-3 ms-2 me-4">
                                    <label asp-for="Dose">Dose<span class="text-danger" style="font-size: 14px;"> *</span></label>
                                    <input name="Dose" required type="text" class="form-control" data-parsley-trigger="change" />                                
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
                                <div class="form-group mb-3 ms-4">
                                    <label asp-for="IntervalsID">Interval<span class="text-danger" style="font-size: 14px;">*</span></label>
                                    <select name="IntervalsID" required class="form-select">
                                        <option selected value="">Select</option>
                                        @foreach (var item in Model.intervalDTOs)
                                        {
                                            <option value="@item.IntervalID">@item.IntervalName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
                                <div class="form-group mb-3 ms-2">
                                    <label asp-for="Durations">Duration<span class="text-danger" style="font-size: 14px;"> *</span></label>
                                    <input required name="Durations" type="text" class="form-control" />                                  
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
                                <div class="form-group mb-3 ms-2">
                                    <label asp-for="DirectionsID">Direction<span class="text-danger" style="font-size: 14px;"> *</span></label>
                                    <select required name="DirectionsID" class="form-select">
                                        <option value="">Select</option>
                                        @foreach (var item in Model.directionDTOs)
                                        {
                                            <option value="@item.DirectionID">@item.DirectionDetails</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
                                <div class="mb-3 me-5 ms-1 pt-4 row">
                                    <button type="button" onclick="RemoveTextBox(this)" class="btn btn-danger backBtn mx-3 mt-1"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--card-body END-->
                    <div class="col-12 text-center mb-3 mt-1">
                        <button class="btn btn-primary btn-big mt-1 mx-2" type="submit" role="button"><span> Save</span></button>
                        <a class="btn btn-big-back mt-1 mx-2" href="/MedicationPlan/Index"><span> Back</span></a>
                    </div>
                </form>
            </div>
        </div>
    </div>
  
    <!--Body content End-->
</div>
<!--Main container End-->
@section Scripts{
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/parsley.js/2.9.2/parsley.min.js"></script>
<script>
    $('#toggle').click(function(){
         $("#medication").select2();
         $('#toggle').hide();
         $('#third').show();
    })
    $(document).ready(function(){
        var doctorname = $('#doctorName').val();
        $('#doctorName1').val(doctorname)
        $('#third').hide();

    })
    $('#addNew').click(function(){
        var div = document.createElement('DIV');
        div.innerHTML = GetDynamicTextbox("");
        document.getElementById("divCont").prepend(div);
        $(".medication2").select2();

    })

    function GetDynamicTextbox(value) {
        return `<div class="row m-4 border mt-3">
        <div class="col-sm-4 col-md-9 col-lg-9 mt-2">
            <div class="form-group mb-3 ms-4">
                <label for="MedicationsID">Medication<span class="text-danger" style="font-size: 14px;"> *</span></label>
                <select name="MedicationsID" required class="form-select medication2">
                    <option selected value="">Select</option>
                    @foreach (var item in Model.medicationDtos)
                    {
                        <option value="@item.MedicationID">@item.MedicationName</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-sm-4 col-md-3 col-lg-3 mt-2">
            <div class="form-group mb-3 ms-2 me-4">
                <label asp-for="Dose">Dose<span class="text-danger" style="font-size: 14px;"> *</span></label>
                <input name="Dose" required type="text" class="form-control" />           
            </div>
        </div>
        <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
            <div class="form-group mb-3 ms-4">
                <label for="Interval">Interval<span class="text-danger" style="font-size: 14px;"> *</span></label>
                <select required class="form-select" name="IntervalsID">
                    <option selected value="">Select</option>
                    @foreach (var item in Model.intervalDTOs)
                    {
                        <option value="@item.IntervalID">@item.IntervalName</option>
                    }
                </select>
            </div>
        </div>
        <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
            <div class="form-group mb-3 me-2 ms-2">
                <label asp-for="Durations">Duration<span class="text-danger" style="font-size: 14px;"> *</span></label>
                <input required name="Durations" type="text" name="Durations" class="form-control" />
            </div>
        </div>
        <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
            <div class="form-group mb-3 ms-2">
                <label asp-for="DirectionsID">Direction<span class="text-danger" style="font-size: 14px;"> *</span></label>
                <select required name="DirectionsID" class="form-select">
                    <option value="">Select</option>
                    @foreach (var item in Model.directionDTOs)
                    {
                        <option value="@item.DirectionID">@item.DirectionDetails</option>
                    }
                </select>
            </div>
        </div>

        <div class="col-sm-4 col-md-3 col-lg-3 mt-1">
            <div class="mb-3 me-5 ms-1 pt-4 row">
                <button type="button" onclick="RemoveTextBox(this)" class="btn btn-danger backBtn mx-3 mt-1"><i class="bi bi-trash"></i></button>
            </div>

        </div>
    </div>`;
    }

    function RemoveTextBox(div) {
        document.getElementById("divCont").removeChild(div.parentNode.parentNode.parentNode.parentNode);

    }
</script>
}
