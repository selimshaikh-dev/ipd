@{
    ViewBag.Title = "Post Surgery Detail";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
@using static IPD.Domain.Constants.Enumerators
@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model PostSurgeriesDto?

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Post Surgery Detail</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>
    @if (Model == null)
    {
        <a class="btn btn-primary btn-big mt-3 fs-6" href="@Url.ActionLink("Create", "PostSurgeries", new { surgeryId = ViewBag.SurgeryId })"><span>Add Post Surgery</span></a>
    }

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        @if (Model != null)
        {
            <!--Chief Complaint-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("ClinicalAssessment")
            </div>

            <div class="col-md-6">
                <div class="card mt-3">
                    @*<div class="responsive_div">*@
                    <div class="card-body">
                        <div class="alert alert-info">
                            <h4>Record saved successfully.</h4>
                        </div>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <td width="30%">Surgery details</td>
                                    <td width="3%" align="center">:</td>
                                    <td width="67%">@Model.SurgeryDetails</td>
                                </tr>
                                <tr>
                                    <td width="30%">Findings</td>
                                    <td width="3%" align="center">:</td>
                                    <td width="67%">@Model.Findings</td>
                                </tr>
                                <tr>
                                    <td width="30%">Post surgery plan</td>
                                    <td width="3%" align="center">:</td>
                                    <td width="67%">@Model.PostSurgeryPlan</td>
                                </tr>
                                <tr>
                                    @{
                                        var patientsConditions = Html.GetEnumSelectList(typeof(PatientsConditions));
                                        var condition = patientsConditions.FirstOrDefault(x => x.Value == Model.PatientsCondition.ToString());
                                    }
                                    <td width="30%">Patients condition</td>
                                    <td width="3%" align="center">:</td>
                                    <td width="67%">@condition?.Text.</td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-center">
                            @if (DateTime.Now.IsWithin24Hours(Model.DateCreated ?? DateTime.Now))
                            {
                                <a class="btn btn-primary btn-big mt-1 mx-2" href="@Url.ActionLink("Edit", "PostSurgeries", new {postSurgeryId = Model.PostSurgeryID})">Edit</a>
                            }
                            <a class="btn btn-primary btn-big mx-2 mt-1" href="@Url.ActionLink("Index", "Surgeries")"><span>Finish</span></a>
                        </p>
                    </div>
                    @*</div>*@
                </div>
            </div>
        }

            <!--Daily observation-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("DailyObservation")
            </div>
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
