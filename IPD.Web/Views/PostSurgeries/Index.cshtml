@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model System.Collections.Generic.List<PostSurgeriesDto>
@{
    ViewBag.Title = "Surgery List";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Surgery</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>
    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
            @*</div>*@
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <table class="table table-bordered table-condensed table-responsive" style="font-size: 14px;">
                        <tbody>
                            <tr style="font-weight: bold;">
                                <td>Surgery details</td>
                                <td>Findings</td>
                            </tr>

                            <tr>
                                <td>
                                    <span>-</span>
                                </td>
                                <td>
                                    <span>-</span>
                                </td>
                            </tr>

                            <tr style="font-weight: bold;">
                                <td>Post surgery plan</td>
                                <td>Patients condition</td>
                            </tr>

                            <tr>
                                <td>
                                    <span>-</span>
                                </td>
                                <td>
                                    <span>-</span>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="4">
                                    <a class="btn btn-primary btn-lg btn-block btn-big mb-3 mt-3" href="@Url.ActionLink("Edit", "PostSurgeries")" role="button"><span>Edit</span></a>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
            @*</div>*@
        </div>

        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
