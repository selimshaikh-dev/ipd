@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model DeathCertificateDto

@{
    ViewData["Title"] = "Death Certificate";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var patient = ViewBag.Patient as PatientDto ?? new PatientDto();
    var admission = ViewBag.Admission as AdmissionsDto ?? new AdmissionsDto();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="text-center mt-3" style="font-size:36px;font-weight:700">Death Certificate</h1>
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6">
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>
                    <table class="table">
                        <tbody>
                            <tr>
                                <td width="30%">Patient name</td>
                                <td width="3%">:</td>
                                <td width="67%">@ViewBag.ClientName</td>
                            </tr>
                            <tr>
                                <td width="30%">Patient age</td>
                                <td width="3%">:</td>
                                <td width="67%">@DateTime.Now.GetYearsMonthsDaysText(patient.DOB)</td>
                            </tr>
                            <tr>
                                <td width="30%">Patient PIN</td>
                                <td width="3%">:</td>
                                <td width="67%">@patient.NationalID</td>
                            </tr>
                            <tr>
                                <td width="30%">Date of admission</td>
                                <td width="3%">:</td>
                                <td width="67%">@admission.AdmissionDate.ToString("MMM-dd-yyyy")</td>
                            </tr>
                            <tr>
                                <td width="30%">Next of kin</td>
                                <td width="3%">:</td>
                                <td width="67%">@admission.NextOfKin</td>
                            </tr>
                            <tr>
                                <td width="30%">Contact number</td>
                                <td width="3%">:</td>
                                <td width="67%">@patient.CellphoneCountryCode @patient.Cellphone</td>
                            </tr>
                            <tr>
                                <td width="30%">Chiefdom name</td>
                                <td width="3%">:</td>
                                <td width="67%">@ViewBag.ChiefdomName</td>
                            </tr>
                            <tr>
                                <td width="30%">Indvuna</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.Indvuna</td>
                            </tr>
                            <tr>
                                <td width="30%">Physical address</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.PhysicalAddress</td>
                            </tr>
                            <tr>
                                <td width="30%">Date of death</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.DateOfDeath.ToString("MMM-dd-yyyy") @Model.TimeOfDeath.ToShortTimeString()</td>
                            </tr>
                            <tr>
                                <td width="30%">Cause of death</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.CauseOfDeath</td>
                            </tr>
                            <tr>
                                <td width="30%">Contributing/antecedent cause or illness</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.OtherReason</td>
                            </tr>
                            <tr>
                                <td width="30%">Approximate interval between onset and death</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.Interval</td>
                            </tr>
                            <tr>
                                <td width="30%">Special investigation, Pathological examin intention of post mortem etc</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.SpecialInvistigation</td>
                            </tr>
                            <tr>
                                <td width="30%">Done under my hand on this</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.HandOn</td>
                            </tr>
                            <tr>
                                <td width="30%">Handed over to</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.HandOver</td>
                            </tr>
                            <tr>
                                <td width="30%">Resident of</td>
                                <td width="3%">:</td>
                                <td width="67%">@Model.Resident</td>
                            </tr>
                        </tbody>
                    </table>
                    <p>
                        <a class="btn btn-primary ms-1 backBtn" href="@Url.ActionLink("Edit", "DeathCertificates", new { deathCertificateId = Model.DeathCertificateID })">Edit</a>
                        <a class="btn btn-primary ms-1 backBtn mx-2" href="@Url.ActionLink("Index", "Admissions", new {patientId = ViewBag.ClientId})">Finish</a>
                    </p>
                </div>
            </div>
        </div>
        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
