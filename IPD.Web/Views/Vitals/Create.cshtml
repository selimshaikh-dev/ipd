@using IPD.Domain.Dto
@model VitalDto
@{
    ViewData["Title"] = "Vitals";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<h1 class="text-center mt-3" style="font-size:36px;">Vitals</h1>
<h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <form asp-action="Create" asp-controller="Vitals" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row mt-3">
            <!--Chief Complaint-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("ClinicalAssessment")
            </div>

            <!--Vitals-->
            <div class="col-md-6">
                @*<div class="responsive_div"> *@
                <div class="card mx-auto mt-2">
                    <div class="card-header text-secondary">
                        Vitals
                    </div>
                    <!--Card-body START-->
                    <div class="card-body pe-3">
                        <fieldset>
                            <!--Date & Time Collected-->
                            <div class="form-group mb-3 me-0 ms-0 row">
                                <div class="col-6">
                                    <label asp-for="DateCollected">Date<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                    <input asp-for="DateCollected" readonly="true" value="" data-val-required="The Date collected is required." class="form-control input-White" type="text">
                                    <span asp-validation-for="DateCollected" class="text-danger"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="TimeCollected">Time<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                    <input asp-for="TimeCollected" value="" data-val-required="The Time collected is required." class="form-control" type="text">
                                    <span asp-validation-for="TimeCollected" class="text-danger"></span>
                                </div>
                            </div>

                            <!--Weight-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Weight">Weight (kg)<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input id="weigth" asp-for="Weight" type="text" class="form-control" data-val-required="The Weight is required." placeholder="Type weight in kilograms (kg)">
                                <span asp-validation-for="Weight" class="text-danger"></span>
                            </div>

                            <!--Height-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Height">Height (cm)</label>
                                <input id="height" asp-for="Height" type="text" class="form-control" placeholder="Type height in centimeteres (cm)">
                                <span asp-validation-for="Height" class="text-danger"></span>
                            </div>

                            <!--Temperature (c)-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Temperature">Temperature (C)<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input id="temp" asp-for="Temperature" type="text" data-val-required="The Temperature is required." class="form-control" placeholder="Type temperature in degrees celcius">
                                <span asp-validation-for="Temperature" class="text-danger"></span>
                            </div>

                            <!--MUAC-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="MUAC">MUAC (cm)</label>
                                <input asp-for="MUAC" type="text" class="form-control" placeholder="Type MUAC in centimeters (cm)">
                                <span asp-validation-for="MUAC" class="text-danger"></span>
                            </div>

                            <!--Bloor Pressure-->
                            <div class="form-group mb-3 me-0 ms-0 row">
                                <label for="">Blood pressure<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <div class="col-6">
                                    <span class="text-muted" style="font-size:13px;">Systolic (mmHg)</span>
                                    <input id="systolic" asp-for="Systolic" type="text" class="form-control" data-val-required="The Systolic is required." placeholder="Type systolic in millimeter of mercury (mmHg)">
                                    <span asp-validation-for="Systolic" class="text-danger"></span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted" style="font-size:13px;">Diastolic (mmHg)</span>
                                    <input id="diastolic" asp-for="Diastolic" type="text" class="form-control" data-val-required="The Diastolic is required." placeholder="Type diastolic in millimeter of mercury (mmHg)">
                                    <span asp-validation-for="Diastolic" class="text-danger"></span>
                                </div>
                            </div>

                            <!--Respiratory rate-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="RespiratoryRate"> Respiratory rate (cpm)</label>
                                <input id="respiratoryRate" asp-for="RespiratoryRate" type="text" class="form-control" placeholder="Type respiratory rate in breaths per minute (bpm)">
                                <span asp-validation-for="RespiratoryRate" class="text-danger"></span>
                            </div>

                            <!--Pulse-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Pulse">Pulse (bpm)<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input id="pulse" asp-for="Pulse" type="text" class="form-control" data-val-required="The Pulse is required." placeholder="Type pulse in beats per minute (bpm)">
                                <span asp-validation-for="Pulse" class="text-danger"></span>
                            </div>

                            <!--Oxygen saturation-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="OxygenSaturation">Oxygen saturation (%)</label>
                                <input asp-for="OxygenSaturation" type="text" class="form-control" placeholder="Type oxygen saturation in percentage (%)">
                                <span asp-validation-for="OxygenSaturation" class="text-danger"></span>
                            </div>

                            <!--Others Vitals-->
                            <div class="form-group mb-2 me-2 ms-2">
                                <label asp-for="OtherVitals">Others vitals</label>
                                <textarea asp-for="OtherVitals" class="form-control text-box multi-line" rows="3" maxlength="500"></textarea>
                                <span asp-validation-for="OtherVitals" class="text-danger"></span>
                            </div>
                        </fieldset>
                    </div>
                    <!--card-body END-->

                    <div class="col-12 text-center mb-3">
                        <button class="btn btn-primary btn-big mt-1 mx-2" type="submit" role="button"><span> Save</span></button>
                        <a class="btn btn-big-back mt-1 mx-2" href="/Vitals/Index"><span> Back</span></a>
                    </div>
                </div>
                @*</div>*@
            </div>

            <!--Daily observation-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("DailyObservation")
            </div>
        </div>
    </form>
    <!--Body content End-->
</div>
<!--Main container End-->
@section Scripts
{
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.min.css" />
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>
<script>
    $(document).ready(function() {

      ClearValues();
      $('input#DateCollected').datetimepicker({
            timepicker:false,
            format:'Y-m-d',
            //minDate: new Date(1900,1-1,1),
            maxDate:0,
            minDate: 0
        });
        $('input#TimeCollected').datetimepicker({
            datepicker:false,
            format:'H:i'
        });
    });

    function ClearValues(){
        if ($('#weigth').val() === '0') {
            $('#weigth').val('');
        }
        if ($('#height').val() === '0') {
            $('#height').val('');
        }
        $('#temp').val('');
        $('#systolic').val('');
        $('#diastolic').val('');
        $('#respiratoryRate').val('');
        $('#pulse').val('');
    }
</script>
}