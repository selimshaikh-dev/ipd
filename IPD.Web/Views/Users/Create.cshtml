@using IPD.Domain.Dto
@model UsersDto
@using static IPD.Domain.Constants.Enumerators
@{
    ViewData["Title"] = "UserRegistration";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var drpFacilities = ViewBag.facilities;
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<!--Main Container START-->
<div class="container">

    <div class="col-12">
        <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
    </div>
    <br />
    <h1 class="text-center" style="font-size:38px;">New User Registration</h1>
    <h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>

    <form asp-action="Create" asp-controller="Users" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <!--User identification-->
        <div class="card mx-auto mt-4 col-md-10 offset-md-3">
            <!--Card header-->
            <div class="card-header text-secondary">
                User Identification
            </div>

            <!--Card-body START-->
            <div class="card-body pe-5">
                <div class="form-horizontal form-group row">
                    <div class="col-md-7">
                        <div class="row">
                            <div class="pb-3">
                                <input checked="checked" id="optPIN" name="SearchOption" type="radio" onclick="Anable()" value="PIN"> PIN&nbsp;
                                <input id="optCode9" name="SearchOption" type="radio"  value="Code9"> Code9&nbsp;
                                <input id="optCode1" name="SearchOption" type="radio" value="Code1"> Code1
                            </div>
                        </div>
                        <div class="row col-md-10">
                            <div class="col-md-8 mt-2">
                                <input asp-for="NationalID" class="form-control text-box single-line"
                                       data-val-length-max="13" data-val-required="PIN is required!" id="txtIdentifire" maxlength="13"
                                       placeholder="Type PIN and click Search..." style="max-width:600px; height: 38px;" type="text" title="The field PIN must be a number with a maximum length of 13." onkeypress="return onlyNumberKey(event)">
                                <span asp-validation-for="NationalID" class="text-danger"></span>
                            </div>
                            <div class="col-md-2 mt-2">
                                <button type="button" name="Command" id="btnSearch" value="Search" class="btn btn-primary mb-2 customBtn" onclick="searchByPin()">
                                    Search
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5" style="padding-top:5px; font-size:13px;">
                        Use <b>Personal Identification Number (PIN)</b> to search User's details.
                        <br>
                        Use <b>Code 9</b> for Swazi citizen who does not have the Swazi PIN.
                        <br>
                        Use <b>Code 1</b> for foreign citizen who does not have the Swazi PIN.
                    </div>
                </div>
            </div>
            <!--Card-body END-->
        </div>

        <!--Personal Details-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-header text-secondary">
                Personal Details
            </div>
            <!--Card-body START-->
            <div class="card-body pe-4">

                <fieldset>
                    <!--First name-->
                    <div class="form-group mb-4 me-4 ms-4 row">
                        <label asp-for="FirstName" class="col-md-3 text-end mt-3">First name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                            <input asp-for="FirstName" type="text" onkeydown="return /[a-z]/i.test(event.key)" id="txtFirstName"
                                   class="form-control" data-val="true" data-val-length-max="30" data-val-required="The first name is required!" placeholder="Enter first name">
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                    </div>

                    <!--Middle Name-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="MiddleName" class="col-md-3 text-end mt-3">Middle name</label>
                        <div class="col-md-9">
                            <input asp-for="MiddleName" id="txtMiddleName" type="text" onkeydown="return /[a-z]/i.test(event.key)" class="form-control" data-val="true" data-val-length-max="30" placeholder="Enter middle name">
                        </div>
                    </div>

                    <!--Last Name-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="LastName" class="col-md-3 text-end mt-3">Last name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                            <input asp-for="LastName" type="text" onkeydown="return /[a-z]/i.test(event.key)" id="txtLastName" 
                                class="form-control" data-val="true" data-val-length-max="30" data-val-required="The last name is required!" placeholder="Enter last name">
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <!--Date of birth-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label for="DOB" class="col-md-3 text-end mt-3">Date of birth<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                            <div class="input-group mb-3">
                                <input name="dateOfBirth" id="dob" type="hidden" />
                                <input name="sex" id="gender" type="hidden" />
                                <input name="DOB" id="datepicker" readonly="true" value="" class="form-control datepicker" data-val-required="Date of birth is required." type="text" />
                                <span class="input-group-text" id="btnPicker">
                                    <span class="bi bi-calendar"></span>
                                </span>
                            </div>
                            <span asp-validation-for="DOB" class="text-danger"></span>
                        </div>
                    </div>

                    <!--sex-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="Sex" class="col-md-3 text-end mt-3">Sex<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                      @*      <select name="Gender" class="form-select">
                                <option>Select</option>
                                <option value="1">Male</option>
                                <option value="2">Female</option>
                                <option value="3">Others</option>
                            </select>*@
                            <select asp-for="Gender" required asp-items="Html.GetEnumSelectList(typeof (Sex))" class="form-select" id="sex">
                                <option value="">Select</option>
                            </select>
                            <span asp-validation-for="Sex" class="text-danger"></span>
                        </div>
                    </div>

                    <!--FacilityID-->
                    <div class="form-group mb-3 me-4 ms-4 row">
                        <label asp-for="FacilityID" class="col-md-3 text-end mt-3">Facility<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-9">
                            <select name="FacilityID" required class="form-select" id="FacilityID" asp-for="FacilityID">
                                <option selected value="">Select</option>
                                @foreach (var ch in drpFacilities)
                                {
                                    <option value="@ch.FacilityID">@ch.FacilityName</option>
                                }
                            </select>
                            <span asp-validation-for="FacilityID" class="text-danger"></span>
                        </div>
                    </div>

                </fieldset>
            </div>
            <!--card-body END-->
        </div>

        <!--Address and Contact Information-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-header text-secondary">
                Address and Contact Information
            </div>
            <!--Card body start-->
            <div class="card-body">
                <!--Cell phone-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label class="control-label col-md-3 text-end mt-3" asp-for="Cellphone">Cellphone<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <!--CountryCode-->
                    <div class="col-md-3">
                        <input asp-for="CellphoneCountryCode" class="form-control text-box single-line" name="CellphoneCountryCode" data-toggle="tooltip" data-val="true" data-val-length-max="3" maxlength="3" placeholder="Country code" title="The field country code must be a number with a maximum length of 3." type="text">
                        <span asp-validation-for="CellphoneCountryCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <input asp-for="Cellphone" class="form-control text-box single-line" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val="true" data-val-length="Cellphone should be atleast 8 digits" data-val-length-max="15" data-val-length-min="8" data-val-required="Cell phone is required." id="txtCellphone" maxlength="15" placeholder="Cellphone number" title="Type cellphone number in this field." type="text">
                        <span asp-validation-for="Cellphone" class="text-danger"></span>
                    </div>
                </div>

                <!--Land phone-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label class="control-label col-md-3 text-end mt-3" asp-for="LandPhone">Land phone</label>
                    <div class="col-md-3">
                        <input asp-for="LandPhoneCountryCode" class="form-control text-box single-line" name="LandPhoneCountryCode" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val="true" data-val-length-max="3" maxlength="3" placeholder="Country code" title="The field Land phone must be a number with a maximum length of 3." type="text">
                    </div>
                    <div class="col-md-6">
                        <input asp-for="LandPhone" class="form-control text-box single-line" name="LandPhone" onkeypress="return onlyNumberKey(event)" data-toggle="tooltip" data-val="true" data-val-length-max="15" maxlength="15" placeholder="Land phone number" title="Landphone should be atleast 8 digits." type="text">
                    </div>
                </div>

                <!--Email Address-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label asp-for="Email" class="col-md-3 text-end mt-3">Email address</label>
                    <div class="col-md-9">
                        <input asp-for="Email" type="email" class="form-control" data-val="true" data-val-length-max="60" aria-describedby="emailHelp">
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <!--Contact address-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label asp-for="ContactAddress" class="col-md-3 text-end mt-4">Contact address<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <textarea asp-for="ContactAddress" class="form-control text-box multi-line" rows="3" data-val="true" data-val-required="The Contact address is required." data-val-length="The field Contact address must be a string with a maximum length of 250." data-val-length-max="250" maxlength="250"></textarea>
                        <span asp-validation-for="ContactAddress" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <!--Card body END-->
        </div>

        <!--Login Information-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-header text-secondary">
                Login Information
            </div>
            <!--Card body start-->
            <div class="card-body">
                <!--User name-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label asp-for="UserName" class="col-md-3 text-end mt-3">Username<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <input asp-for="UserName" type="text" class="form-control" id="Username" data-val="true" data-val-length-max="30" data-val-required="Username is required!" placeholder="Enter username">
                        <span asp-validation-for="UserName" class="text-danger"></span>
                        <span id="userValidation" class="text-danger">Username already exist!!</span>
                    </div>
                </div>

                <!--Password-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label asp-for="Password" class="col-md-3 text-end mt-3">Password<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <input asp-for="Password" class="form-control" data-toggle="tooltip" data-val="true" data-val-required="The Contact address is required." data-val-length="Password should be atleast 8 digits" data-val-length-max="15" data-val-length-min="8" placeholder="New password" title="Type a strong password in this field with minimum limit 8 digits." type="password">
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <!--Confirm Password-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label asp-for="ConfirmPassword" class="col-md-3 text-end mt-3">Confirm password<span class="text-danger" style="font-size:14px;"> *</span></label>
                    <div class="col-md-9">
                        <input asp-for="ConfirmPassword" type="password" id="confirm_password" class="form-control" data-toggle="tooltip" data-val="true" data-val-length=" Confirm password should be atleast 8 digits" data-val-length-max="15" data-val-length-min="8" maxlength="15" placeholder="Confirm password" title="Re-enter your password in this field with minimum limit 8 digits." type="password">
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>

            </div>
            <!--Card body END-->
        </div>

        <!--Button START-->
        <div class="card mx-auto mt-4 col-md-10">
            <div class="card-body">
                <div class="text-center">
                    <div class="form-group fs-3">
                        <button type="submit" id="btnSave" class="btn btn-primary btn-big mt-3 mx-2" value="Create">
                            <span>Save</span>
                        </button>
                        <a class="btn btn-big-back mt-3 mx-2" href="/"><span> Back</span></a>
                    </div>
                </div>
            </div>
        </div>
        <!--Button END-->
    </form>
</div>

<!--Main Container END-->
@section scripts {
<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css">
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
<script>

        var timer;
    $("#Username").on("keyup", function(){
        var searchid = $(this).val().trim();
            var url = `@Model.BaseUrl/Users/GetAllUserList`
            $.ajax({
              url: url,
              cache: false,
              success: function(data){
                  $.each(data, function (i, item) {
                    if(item.username.toUpperCase() === searchid.toUpperCase()){
                        $('#userValidation').show();
                        $("#btnSave").attr( "disabled", "disabled" );
                            return false;
                    }else{
                        $("#btnSave").removeAttr("disabled");
                        $('#userValidation').hide();

                    }
                });
              }
             });
    });

        $(document).ready(function () {

            $("#optPIN").attr("checked", true);
            $("#txtIdentifire").val('');
            $("#userValidation").hide();
            addReadonlyAttr();
            ClearDemographics();
            DisableDemographics();

            $("#ddlChiefdomID").html("<option value=\"\">Select</option>");
            $('[data-toggle="tooltip"]').tooltip();


            //Mapping relavant chiefdoms to Inkhundla
            $("#ddlTinkhundlaID").change(function () {
                $("#ddlChiefdomID").empty();

                $.ajax({
                    url: "/Client/GetChiefdomByInkhundla",

                    dataType: "json",

                    type: "GET",

                    data: { id: $("#ddlTinkhundlaID").val() },

                    success: function (data) {
                        var items = "";
                        items = "<option value=\"\">Select</option>";
                        $.each(data, function (i, item) {
                            items += "<option value=\"" + item.Value + "\">" + item.Text + "</option>";
                        });

                        $("#ddlChiefdomID").html(items);
                    }
                });
            });

            //Disabling input for demographics if pin is supplied
            $("#optPIN").click(function () {
                $("#txtIdentifire").val('');
                addReadonlyAttr();
                ClearDemographics();
                DisableDemographics();
            });

            $('#optCode9').click(function(){
            $('#txtIdentifire').val('');
            $('#txtIdentifire').val(9999999999999);
            enadbleTextMode();
            removeReadonlyAttr();
            });

            $("#optCode1").click(function () {
                $('#txtIdentifire').val();
                $('#txtIdentifire').val(1111111111111);
                enadbleTextMode();
                removeReadonlyAttr();
            });

            function DisableDemographics()
            {
                $("#txtFirstName").bind("keypress, keydown", false)
                $("#txtMiddleName").bind("keypress, keydown", false);
                $("#txtLastName").bind("keypress, keydown", false);
                $("#txtDOB").bind("keypress, keydown", false);
            }
            function ClearDemographics()
            {
                $("#txtFirstName").val("")
                $("#txtMiddleName").val("")
                $("#txtLastName").val("")
                $("#txtDOB").val("")
                $("#ddlSex").val("")
            }
           });
           function enableTxt() {
      document.getElementById("name_text_field").disabled = false;
    }



        function onlyAlphabets(e, t) {
            if (window.event) {
                var charCode = window.event.keyCode;
            }
            else if (e) {
                var charCode = e.which;
            }
            else { return true; }

            if (charCode == 8 || charCode == 9 || charCode == 32 || charCode == 37 || charCode == 39)
                return true;

            if ((charCode > 64 && charCode < 91) || (charCode > 96 && charCode < 123))
                return true;
            else
                return false;
        }

         function show() {
           var a = document.getElementById("confirm_password");
           var b = document.getElementById("display2");
           if (a.type == "password") {
           a.type = "text";

           } else {
             a.type = "password";
           }
         }


         function enadbleTextMode(){
                $("#txtFirstName").val("").unbind("keypress, keydown")
                $("#txtMiddleName").val("").unbind("keypress, keydown");
                $("#txtLastName").val("").unbind("keypress, keydown");
                $("#txtDOB").val("").unbind("keypress, keydown");
         }

         function removeReadonlyAttr()
                      {
                       $('#txtFirstName').attr('readonly',false);
                       $('#txtMiddleName').attr('readonly',false);
                       $('#txtLastName').attr('readonly',false);
                       $('#datepicker').attr('readonly',false,);
                    $('#sex').attr('readonly',false,);
                     $('#sex').attr('disabled',false);
                       $('#datepicker').attr('disabled',false);
                      }
         function addReadonlyAttr()
                      {
                      $('#txtFirstName').attr('readonly',true);
                        $('#txtFirstName').attr('readonly',true);
                        $('#txtMiddleName').attr('readonly',true);
                        $('#txtLastName').attr('readonly',true);
                       $('#sex').attr("disabled", true);
                        $('#datepicker').attr("disabled", true);
                      }

</script>

<!---Essential Link for datetimepicker -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
<script src="https://code.jquery.com/jquery-1.12.4.js"></script>
<script src="https://code.jquery.com/ui/1.12.1/jquery-ui.js"></script>

<!--Function for datetime picker with future date validation-->
<script>
        $(function () {
             $('#datepicker').datepicker({
                dateFormat: 'mm-dd-yy',
                showButtonPanel: true,
                changeMonth: true,
                changeYear: true,
                yearRange: '1900:2022',
                inline: true,
                minDate: new Date(1900,1-1,1),
                maxDate: '-18Y'
             });
        });

        $("#btnPicker").click(function () {

        $("#datepicker").focus();
        });

    function onlyNumberKey(evt) {

            // Only ASCII character in that range allowed
            var ASCIICode = (evt.which) ? evt.which : evt.keyCode
            if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
                return false;
            return true;
        };

       function alphaOnly(event) {
      var key = event.keyCode;
      return ((key >= 65 && key <= 90) || key == 8);
    };

    function searchByPin(){
            const checkedPin = $('#optPIN').attr('checked');
          //  console.log(checkedPin);
            if(checkedPin){
             const pin = $('#txtIdentifire').val();
             $.ajax({
                    url: "@Model.BaseUrl/Patients/PinSearchDapper?Pin="+pin,
                    dataType: "json",
                    type: "GET",
                    success: function (data) {
                        $('#txtFirstName').val(data[0].firstName);
                        $('#txtMiddleName').val(data[0].middleName);
                        $('#txtLastName').val(data[0].lastName);
                        $('#datepicker').val(convertDateMMddyyyy(data[0].dob));
                        $('#dob').val(convertDateMMddyyyy(data[0].dob));
                        $('#sex').val(data[0].sex);
                        $('#gender').val(data[0].sex);
                       addReadonlyAttr();


                    }
                });
            }
        }

</script>
}
