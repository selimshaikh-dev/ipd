@using IPD.Domain.Dto
@model ChangedPasswordDto
@{
    ViewData["Title"] = "ChangePassword";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />


<!--Main container Start-->
<div class="container">
    <div class="col-12">
        <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
    </div>
    <br />
    <div class="col-md-8 offset-md-2 text-center">
        <h1 class="text-center text-capitalize" style="font-size:38px;">Change Password </h1>
        <h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>


    <!--Form Start-->
    <form asp-action="ChangePassword" asp-controller="Users" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="card mx-auto mt-3 col-md-8 offset-md-3">
            <div class="card-header text-secondary">
                Change password
            </div>
            <!--Card body start-->
            <div class="card-body pe-4">
                <!--Current Password-->
                <div class="form-group mb-3 me-4 ms-4 row ">
                    <label class="control-label col-md-4 text-end mt-3 " asp-for="Password">Current Password<span class="text-danger" style="font-size:12px;"> *</span></label>

                    <div class="col-md-8">
                        <input type="hidden" asp-for="UserName" />
                        <input type="hidden" id="errMessage"  value="@ViewBag.message" />
                        <input asp-for="Password" class="form-control text-box single-line" placeholder="Current Password" type="password">
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <!--Password-->
                <div class="form-group mb-3 me-4 ms-4 row">
                    <label class="control-label col-md-4 text-end mt-3" for="NewPassword">New Password<span class="text-danger" style="font-size:12px;"> *</span></label>

                    <div class="col-md-8">
                        <input asp-for="NewPassword" class="form-control text-box single-line" data-toggle="tooltip" data-val-length="Password should be atleast 8 digits" data-val-length-max="15" data-val-length-min="8" maxlength="15" placeholder="New password" title="Type new password in this field with minimum limit 8 digits." type="password">
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                    </div>
                </div>

                <!--Confirm Password-->
                <div class="form-group mb-3 me-4 ms-4 row ">
                    <label class="control-label col-md-4 text-end mt-3" asp-for="ConfirmPassword">Confirm New Password<span class="text-danger" style="font-size:12px;"> *</span></label>
                    <div class="col-md-8">
                        <input asp-for=ConfirmPassword class="form-control text-box single-line" data-toggle="tooltip" data-val-length=" Confirm password should be atleast 8 digits" data-val-length-max="15" data-val-length-min="8" maxlength="15" placeholder="Confirm Password" title="Re-enter your password in this field with minimum limit 8 digits." type="password">
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <!--Card body END-->
        </div>
        <!--Button START-->
        <div class="card mx-auto mt-4 col-md-8">
            <div class="card-body">
                <div class="text-center">
                    <div class="form-group">
                        <button class="btn btn-primary btn-big mx-2" value="Create" type="submit">
                            <span>Save</span>
                        </button>
                        <a class="btn btn-big-back mx-2" href="/Clients/profileSearch"><span> Back</span></a>
                    </div>
                </div>
            </div>
        </div>
        <!--Button END-->
    </form>
    <!--Form End-->
</div>
<div class="position-fixed top-0 end-0 p-3" style="z-index: 11">
    <div id="toast--error-partograph" class="toast hide align-items-center text-white bg-danger" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-bold fs-6">
                <i class="bi bi-exclamation-triangle"></i>
                Warning! <br />
                <span>Not applicable for male patient.</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
<!--Main container End-->
@section Scripts{
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>
    <script>
        $(document).ready(function(){
            var message = $('#errMessage').val();         
          if(message == 'not_found'){
              swal("Sorry", "Current password not match!");
          } 
        })
    </script>
}