@using IPD.Domain.Dto
@using IPD.Web.Extensions
@using static IPD.Domain.Constants.Enumerators
@model List<ChiefComplaintsDto>
@{
    ViewBag.Title = "Clinical Assessment";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var ncds = ViewBag.Ncds as List<NcdDto> ?? new List<NcdDto>();
    var allergies = ViewBag.Allergies as List<AllergiesDto> ?? new List<AllergiesDto>();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

@*Logo*@
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Record Chief Complaint</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Navabr button-->
    <nav class="navbar navbar-light offset-md-1 mt-3">
        <form class="container-fluid justify-content-start">
            <a href="/ChiefComplaints/Index" class="btn btn-primary btnNav me-2 my-1" role="button">Chief Complaint</a>
            <a href="/PatientExaminations/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Examinations</a>
            <a href="/Diagnosis/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Diagnosis</a>
            <a href="/TreatmentPlan/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Treatment Plan</a>
            <a href="/MedicationPlan/Index" class="btn btn-outline-secondary btnNav me-2 my-1" role="button">Medication Plan</a>
        </form>
    </nav>

    <!--Header-->
    <div class="col-md-10 offset-1 mt-3">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 offset-md-1 mt-1">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-7 mt-1">
            @*<div class="responsive_div">*@

            <a href="@Url.ActionLink("Create", "ChiefComplaints")" class="btn btn-primary btn-big fs-6"><span>Add New</span></a>

            @if (Model.Any())
            {
                @foreach (var clinicalAssessment in Model)
                {
                    <div class="card mt-3 mb-3">
                        <div class="card-body pb-0">
                            <h6 style="color:#317eac;"> Date Created: @clinicalAssessment.DateCreated.Value.ToString("dd-MM-yyyy, hh:mm ttt")</h6>

                            <table class="table table-condensed table-responsive" style="font-size: 15px;">
                                <tbody>
                                    @{
                                        var hypertentionSelectedItems = Html.GetEnumSelectList(typeof(Hypertention));
                                        var hypertentionItem = hypertentionSelectedItems.FirstOrDefault(x => x.Value == clinicalAssessment.Hypertention.ToString());
                                        string hypertentionText = hypertentionItem?.Text ?? string.Empty;

                                        var epilepsySelectedItems = Html.GetEnumSelectList(typeof(Epilepsy));
                                        var epilepsyItem = epilepsySelectedItems.FirstOrDefault(x => x.Value == clinicalAssessment.Epilepsy.ToString());
                                        string epilepsyText = epilepsyItem?.Text ?? string.Empty;

                                        var diabetesSelectedItems = Html.GetEnumSelectList(typeof(Diabetes));
                                        var diabetesItem = diabetesSelectedItems.FirstOrDefault(x => x.Value == clinicalAssessment.Diabetes.ToString());
                                        string diabetesText = diabetesItem?.Text ?? string.Empty;
                                    }
                                    <tr>
                                        <td colspan="3" class="fs-5 text-secondary shadow-sm" style="background-color: rgba(0,0,0,.03);">
                                            <span>Chief complaints</span>
                                            @if (DateTime.Now.IsWithin24Hours(clinicalAssessment.DateCreated ?? DateTime.Now))
                                            {
                                                <span class="float-end">
                                                    <a href="@Url.ActionLink("Edit", "ChiefComplaints", new {complaintId = clinicalAssessment.ComplaintID})" class="btn btn-primary backBtn">Edit</a>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="30%">Chief complaint</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@clinicalAssessment.ComplaintName</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="30%">History of chief complaints</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@clinicalAssessment.ComplaintHistory</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="30%">Other systems review</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@clinicalAssessment.SystemsReview</span>
                                        </td>
                                    </tr> 
                                    <tr>
                                        <th width="30%">Hypertension</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@hypertentionText</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="30%">Epilepsy</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@epilepsyText</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="30%">Diabetes</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@diabetesText</span>
                                        </td>
                                    </tr>                                             
                                    <tr>
                                        @{
                                            string ncdText = string.Empty;
                                            if (clinicalAssessment.PatientsNcds?.Any() ?? false)
                                            {
                                                var ncdIdList = clinicalAssessment.PatientsNcds.Select(x => x.NcdsID).ToList();
                                                var ncdList = ncds.Where(x => ncdIdList.Contains(x.NcdsID)).ToList();
                                                ncdText = string.Join(", ", ncdList.Select(x => x.NcdName));
                                            }

                                            string allergyText = string.Empty;
                                            if (clinicalAssessment.PatientAllergy?.Any() ?? false)
                                            {
                                                var allergyIdList = clinicalAssessment.PatientAllergy.Select(x => x.AllergiesID).ToList();
                                                var allergyList = allergies.Where(x => allergyIdList.Contains(x.AllergiesID)).ToList();
                                                allergyText = string.Join(", ", allergyList.Select(x => x.AllergiesName));
                                            }
                                        }
                                        <th width="30%">Other NCDs</th>
                                        <td width="3">:</td>
                                        <td width="67%">
                                            <span>@ncdText</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th width="30%">Allergies</th>
                                        <td width="3">:</td>
                                        <td>@allergyText</td>
                                    </tr>
                                    <tr>
                                        <th width="30%">Special note for NCDs or Allergies</th>
                                        <td width="3">:</td>
                                        <td>@clinicalAssessment.SpecialNote</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            @*</div>*@
            <a href="/Clients/ManageClient?patientId=@ViewBag.ClientId" class="btn btn-sm-back"><span>Back</span></a>
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
