@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model ChiefComplaintsDto
@using static IPD.Domain.Constants.Enumerators
@{
    ViewData["Title"] = "ClinicalAssessment Details";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var ncds = ViewBag.Ncds as List<NcdDto> ?? new List<NcdDto>();
    var allergies = ViewBag.Allergies as List<AllergiesDto> ?? new List<AllergiesDto>();
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Chief Complaints</h1>
        <hr class="mt-4" style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="col-md-10 offset-md-1 mt-3">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 offset-md-1 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-7">
            @*<div class="responsive_div">*@
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <table class="table table-condensed table-responsive">
                        <tbody>
                            @{
                                var hypertentionSelectedItems = Html.GetEnumSelectList(typeof(Hypertention));
                                var hypertentionItem = hypertentionSelectedItems.FirstOrDefault(x => x.Value == Model.Hypertention.ToString());
                                string hypertentionText = hypertentionItem?.Text ?? string.Empty;

                                var epilepsySelectedItems = Html.GetEnumSelectList(typeof(Epilepsy));
                                var epilepsyItem = epilepsySelectedItems.FirstOrDefault(x => x.Value == Model.Epilepsy.ToString());
                                string epilepsyText = epilepsyItem?.Text ?? string.Empty;

                                var diabetesSelectedItems = Html.GetEnumSelectList(typeof(Diabetes));
                                var diabetesItem = diabetesSelectedItems.FirstOrDefault(x => x.Value == Model.Diabetes.ToString());
                                string diabetesText = diabetesItem?.Text ?? string.Empty;
                            }
                            <tr>
                                <td width="30%">Chief complaint</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.ComplaintName</td>
                            </tr>
                            <tr>
                                <td width="30%">History of chief complaints</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.ComplaintHistory</td>
                            </tr>
                            <tr>
                                <td width="30%">Other systems review</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.SystemsReview</td>
                            </tr>
                            <tr>
                                <td width="30%">Diabetes </td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">
                                    @diabetesText
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Hypertension</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@hypertentionText</td>
                            </tr>
                            <tr>
                                <td width="30%">Epilepsy </td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@epilepsyText</td>
                            </tr>
                            @{
                                string ncdText = string.Empty;
                                if (Model.PatientsNcds?.Any() ?? false)
                                {
                                    var ncdIdList = Model.PatientsNcds.Select(x => x.NcdsID).ToList();
                                    var ncdList = ncds.Where(x => ncdIdList.Contains(x.NcdsID)).ToList();
                                    ncdText = string.Join(", ", ncdList.Select(x => x.NcdName));
                                }

                                string allergyText = string.Empty;
                                if (Model.PatientAllergy?.Any() ?? false)
                                {
                                    var allergyIdList = Model.PatientAllergy.Select(x => x.AllergiesID).ToList();
                                    var allergyList = allergies.Where(x => allergyIdList.Contains(x.AllergiesID)).ToList();
                                    allergyText = string.Join(", ", allergyList.Select(x => x.AllergiesName));
                                }
                            }
                            <tr>
                                <td width="30%">Other NCDs</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@ncdText</td>
                            </tr>
                            <tr>
                                <td width="30%">Allergies</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@allergyText</td>
                            </tr>
                            <tr>
                                <td width="30%">Special note for NCDs or Allergies</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.SpecialNote</td>
                            </tr>
                        </tbody>
                    </table>

                    <p class="text-center">
                        <a class="btn btn-primary btn-big mt-3" href="@Url.ActionLink("Index", "ChiefComplaints")">Finish</a>
                    </p>
                </div>
            </div>
            @*</div>*@
        </div>

        @*<!--Daily observation-->
            <div class="col-md-4 mt-2">
            @await Component.InvokeAsync("DailyObservation")
            </div>*@
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
