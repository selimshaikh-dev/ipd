@using IPD.Domain.Dto
@model DiabeticsProfileDto
@{
    ViewData["Title"] = "Diabetic Profile";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Diabetes</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6">
            @*<div class="responsive_div">*@
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <table class="table table-condensed table-responsive">
                        <tbody>
                            <tr>
                                <td width="30%">Date collected</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%" align="left">
                                    <span>@Model.DateCollected.ToLongDateString()</span>
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Date collected</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%" align="left">
                                    <span>@Model.TimeCollected.ToShortTimeString()</span>
                                </td>
                            </tr>
                            <tr>
                                <td>Blood Suger</td>
                                <td>:</td>
                                <td>
                                    <span>@Model.BloodSuger</span>
                                </td>
                            </tr>

                            <tr>
                                <td>Urine suger</td>
                                <td align="center">:</td>
                                <td align="left">
                                    @*<span>@Model.UrinSuger</span>*@
                                    @{
                                        if ((double)Model.UrinSuger > 0.8)
                                        {
                                            <span class="text-danger">@Model.UrinSuger mmol/L</span>
                                        }
                                        else
                                        {
                                            <span>@Model.UrinSuger mmol/L</span>
                                        }
                                    }
                                </td>
                            </tr>

                            <tr>
                                <td>Urine ketones</td>
                                <td align="center">:</td>
                                <td align="left">
                                    <span>@Model.UrinKetones</span>
                                </td>
                            </tr>

                            <tr>
                                <td>Insulin dose</td>
                                <td align="center">:</td>
                                <td align="left">
                                    <span>@Model.InsulinDose</span>
                                </td>
                            </tr>

                        </tbody>
                    </table>

                    <p class="text-center">
                        <a class="btn btn-primary btn-big mt-3" href="@Url.ActionLink("Index", "DiabeticProfile")">Finish</a>
                    </p>
                </div>
            </div>
            @*</div>*@
        </div>

        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
