@using IPD.Domain.Dto
@model DiabeticsProfileDto

@{
    ViewData["Title"] = "Diabetic Profile";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<h1 class="text-center text-capitalize mt-3" style="font-size:36px;">Diabetic Profile</h1>
<h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>

<!--Main container Start-->
<div class="container-fluid mt-3">

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <form asp-action="Edit" asp-controller="DiabeticProfile" method="post">
        <div class="row mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <!--Chief Complaint-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("ClinicalAssessment")
            </div>

            <div class="col-md-6">
                @*<div class="responsive_div">*@
                <!--Diabetes-->
                <div class="card mx-auto mt-2">
                    <div class="card-header text-secondary">
                        Diabetes
                    </div>
                    <!--Card-body START-->
                    <div class="card-body pe-3">
                        <fieldset>
                            <input type="hidden" asp-for="DiabeticProfileID" value="@Model.DiabeticProfileID" />
                            <input type="hidden" asp-for="AdmissionID" value="@Model.AdmissionID" />

                            <!--Date & Time Of Collected-->
                            <div class="form-group mb-3 me-0 ms-0 row">
                                <div class="col-6">
                                    <label asp-for="DateCollected">Date</label><span class="text-danger" style="font-size:15px;"> *</span>
                                    <input asp-for="DateCollected" readonly="true" value="@Model.DateCollected.ToString("yyyy-MM-dd")" data-val-required="The DateCollected is required." class="form-control input-White" type="text">
                                    <span asp-validation-for="DateCollected" class="text-danger"></span>
                                </div>

                                <!--Time-->
                                <div class="col-6">
                                    <label asp-for="TimeCollected">Time</label><span class="text-danger" style="font-size:15px;"> *</span>
                                    <input asp-for="TimeCollected" value="@Model.TimeCollected.ToString("HH:mm")" data-val-required="The TimeCollected is required." class="form-control" type="text">
                                    <span asp-validation-for="TimeCollected" class="text-danger"></span>
                                </div>
                            </div>

                            <!--Blood Sugar-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="BloodSuger">Blood sugar<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input asp-for="BloodSuger" type="text" class="form-control" data-val-length-max="30">
                                <span asp-validation-for="BloodSuger" class="text-danger"></span>
                            </div>

                            <!--UrinSuger-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="UrinSuger">Urine sugar<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input asp-for="UrinSuger" type="text" class="form-control" data-val-length-max="30">
                                <span asp-validation-for="UrinSuger" class="text-danger"></span>
                            </div>

                            <!--UrinKetones-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="UrinKetones">Urine ketones<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input asp-for="UrinKetones" type="text" class="form-control" data-val-length-max="30">
                                <span asp-validation-for="UrinKetones" class="text-danger"></span>
                            </div>

                            <!--Insulin Dose-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="InsulinDose">Insulin dose<span class="text-danger" style="font-size:15px;"> *</span></label>
                                <input asp-for="InsulinDose" type="text" class="form-control" data-val-length-max="30">
                                <span asp-validation-for="InsulinDose" class="text-danger"></span>
                            </div>

                        </fieldset>
                    </div>
                    <!--card-body END-->

                    <div class="col-12 text-center mb-3">
                        <button class="btn btn-primary btn-big mt-1 mx-2" type="submit" role="button"><span> Save</span></button>
                        <a class="btn btn-big-back mt-1 mx-2" href="/DiabeticProfile/Index"><span> Back</span></a>
                    </div>
                </div>
                @*</div>*@
            </div>

            <!--Daily observation-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("DailyObservation")
            </div>
        </div>
    </form>
    <!--Body content End-->
</div>
<!--Main container End-->
@section Scripts
{
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.min.css" />
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>
<script>
    $(document).ready(function() {
        $('input#DateCollected').datetimepicker({
            timepicker:false,
            format:'Y-m-d',
            maxDate:0,
            minDate: 0
        });
        $('input#TimeCollected').datetimepicker({
            datepicker:false,
            format:'H:i'
        });
    });
</script>
}