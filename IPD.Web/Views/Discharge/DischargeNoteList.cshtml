@using IPD.Web.Extensions
@model DischargeNoteListViewModels

@{
    ViewData["Title"] = "Discharge Note List";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container body-content mt-3">
    <div class="col-md-10">
        <h1 class="text-capitalize mt-3" style="font-size:36px; font-weight:700;">Discharge Note</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>
    <a class="btn btn-primary btn-big mt-3 fs-6" href="@Url.ActionLink("Create", "Discharge")"><span>Add New</span></a>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClinicalAssessment")
    </div>

    <!--Body content Start-->
    <div class="col-md-10 mt-5">
        @foreach (var discharge in Model.DischargeNotes)
        {
            <div class="card">
                <div class="card-body">
                    <h5>Discharge Date :  @discharge.DischargeDate.ToLongDateString() @discharge.DischargeTime.ToShortTimeString()</h5>
                    <table class="table table-bordered table-condensed table-responsive" style="font-size: 13px;">
                        <tbody>
                            <tr style="font-weight: bold;">
                                <td>Discharge Status</td>
                                <td>Advice for the Client</td>
                                <td>Diet and Nutrition Advice</td>
                                <td>Medication advice</td>
                            </tr>
                            <tr>
                                <td>
                                    @{
                                        var status = Model?.DischargeStatuses.FirstOrDefault(x => x.DischargeStatusID == discharge?.DischargeStatusID);
                                    }
                                    @status?.DischargesStatus
                                </td>
                                <td>
                                    <span>@discharge.Advice</span>
                                </td>
                                <td>
                                    <span>@discharge.DietNutritionAdvice</span>
                                </td>
                                <td>
                                    <span>@discharge.MedicationAdvice</span>
                                </td>
                            </tr>

                            <tr style="font-weight: bold;">
                                <td>Final diagnosis</td>
                                <td>Remarks</td>
                            </tr>
                            <tr>
                                <td>
                                    <span>@discharge.FinalDiagnosis</span>
                                </td>
                                <td>
                                    <span>@discharge.Remarks</span>
                                </td>
                            </tr>
                            <tr align="right">
                                <td colspan="4">
                                    @if (DateTime.Now.IsWithin24Hours(discharge.DateCreated ?? DateTime.Now))
                                    {
                                        <a class="btn btn-primary btn-big mt-3" href="@Url.ActionLink("Edit", "Discharge", new {dischargeId = discharge.DischargeID})" role="button"><span>Edit</span></a>
                                    }
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    <!--Body content End-->
</div>
<!--Main container End-->
