@model DischargeNoteViewModels

@{
    ViewData["Title"] = "Discharge Detail";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Discharge</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6">
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <table class="table">
                        <tbody>
                            <tr>
                                <td width="30%">Discharge date</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model?.Create?.DischargeDate.ToLongDateString() @Model?.Create?.DischargeTime.ToShortTimeString()</td>
                            </tr>
                            <tr>
                                <td width="30%">Discharge Status</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">
                                    @{
                                        var status = Model.DischargeStatuses.FirstOrDefault(x => x.DischargeStatusID == Model.Create?.DischargeStatusID);
                                    }
                                    @status?.DischargesStatus
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Advice for the Client</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Create?.Advice</td>
                            </tr>
                            <tr>
                                <td width="30%">Diet and Nutrition Advice</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Create?.DietNutritionAdvice</td>
                            </tr>
                            <tr>
                                <td width="30%">Medication advice</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Create?.MedicationAdvice</td>
                            </tr>
                            <tr>
                                <td width="30%">Final diagnosis</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Create?.FinalDiagnosis</td>
                            </tr>
                            <tr>
                                <td width="30%">Remarks</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Create?.Remarks</td>
                            </tr>
                        </tbody>
                    </table>
                    <p>
                        <a class="btn btn-primary ms-2 backBtn mt-3" href="@Url.ActionLink("Edit", "Discharge", new {dischargeId = Model?.Create?.DischargeID})">Edit</a>
                        <a class="btn btn-primary ms-2 backBtn mt-3 mx-2" href="@Url.ActionLink("Index", "Admissions", new {patientId = ViewBag.ClientId})">Finish</a>
                    </p>
                </div>
            </div>
        </div>
        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
