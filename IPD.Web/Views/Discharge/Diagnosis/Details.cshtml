@using IPD.Domain.Dto
@model PatientDiagnosisDto
@{
    ViewData["Title"] = "Diagnosis";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var diagnosisCodes = ViewBag.DiagnosisCode as List<ICDDigonosisCodeDto> ?? new List<ICDDigonosisCodeDto>();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px; font-weight:700;">Diagnosis</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="col-md-10 offset-md-1 mt-3">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief complaint-->
        <div class="col-md-3 offset-md-1 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-7">
            @*<div class="responsive_div">*@
            <div class="card mx-auto mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>
                    @{
                        var diagnosisIds = Model.DiagonosisDetails.Select(x => x.DiseaseID).ToList();
                        var diagnosisDetails = diagnosisCodes
                        .Where(x => diagnosisIds.Contains(x.DiseaseID))
                        .ToList();
                    }
                    <table class="table table-condensed table-responsive">
                        <tbody>
                            <tr>
                                <td width="30%">ICD diagnosis</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%" align="left">
                                    @foreach (var diagnosisCode in diagnosisDetails)
                                    {
                                        <span>@diagnosisCode?.ICDCode @diagnosisCode?.Description</span> <br />
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Findings</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%" align="left">@Model.DiagnosisNote</td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-center mb-3">
                        <a class="btn btn-primary btn-big mt-3" href="/Diagnosis/Index">Finish</a>
                    </p>
                </div>
            </div>
            @*</div>*@
        </div>

        <!--Daily observation-->
        @*<div class="col-md-4 mt-2">
            @await Component.InvokeAsync("DailyObservation")
            </div>*@
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
