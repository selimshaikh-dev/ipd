@using IPD.Domain.Dto
@model RequestForReferralsDto
@{
    ViewData["Title"] = "Internatinal referral details";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="mt-3" style="font-size:36px;font-weight:700">Request for International/Local Referral</h1>
        <h5>All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6">
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <table class="table">
                        <tbody>
                            @{
                                if (Model.InternationalReferral != null)
                                {
                                    var InternationalReferral = Model.InternationalReferral;
                                    <tr>
                                        <td width="30%">Phalala</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.Phalala</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Civil servent</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.CivilServent</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Contact details</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.ContactDetails</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Date</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.Date.ToString("dd-MM-yyyy") @InternationalReferral.Time.ToString("HH:mm")</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Discipline</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.Discipline</td>
                                    </tr>
                                }

                                if (Model.InternationalReferral != null)
                                {
                                    var InternationalReferral = Model.InternationalReferral;
                                    <tr>
                                        <td width="30%">Allergies</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.Allergies</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Chronic illness</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.ChronicIllness</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Employer</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.Employer</td>
                                    </tr>
                                    <tr>
                                        <td width="30%">Medication</td>
                                        <td width="3%" align="center">:</td>
                                        <td width="67%">@InternationalReferral.Medication</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    <p>
                        <a class="btn btn-primary backBtn mx-2" href="@Url.ActionLink("Index", "InternationalReferral")">Finish</a>
                    </p>
                </div>
            </div>
        </div>

        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
