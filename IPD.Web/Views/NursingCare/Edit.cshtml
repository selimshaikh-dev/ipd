@using IPD.Domain.Dto
@model NursingCaresDto

@{
    ViewBag.Title = "Nursing Care";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<h1 class="text-center text-capitalize mt-3" style="font-size:36px;">Nursing Care</h1>
<h5 class="text-center">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <form asp-action="Edit" asp-controller="NursingCare" method="post">
        <div class="row mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <!--Chief Complaint-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("ClinicalAssessment")
            </div>

            <!--Nursing care-->
            <div class="col-md-6">
                @*<div class="responsive_div">*@
                <div class="card mx-auto mt-2">
                    <div class="card-header text-secondary">
                        Nursing care
                    </div>
                    <!--Card-body START-->
                    <div class="card-body pe-3">
                        <fieldset>
                            <input type="hidden" asp-for="NursingCareID" value="@Model.NursingCareID" />
                            <input type="hidden" asp-for="AdmissionID" value="@Model.AdmissionID" />

                            <!--Date & Time Of Note-->
                            <div class="form-group mb-3 me-0 ms-0 row">
                                <div class="col-6">
                                    <label asp-for="DateOfCare">Date<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                    <input asp-for="DateOfCare" readonly="true" value="@Model.DateOfCare.ToString("yyyy-MM-dd")" data-val-required="The DateCollected is required." class="form-control input-White" type="text">
                                    <span asp-validation-for="DateOfCare" class="text-danger"></span>
                                </div>
                                <div class="col-6">
                                    <label asp-for="TimeOfCare">Time<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                    <input asp-for="TimeOfCare" value="@Model.TimeOfCare.ToString("HH:mm")" data-val-required="The TimeCollected is required." class="form-control" type="text">
                                    <span asp-validation-for="TimeOfCare" class="text-danger"></span>
                                </div>
                            </div>

                            <!--Problem/Need-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Problem">Problem/Need<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                <textarea asp-for="Problem" value="@Model.Problem" class="form-control text-box multi-line" rows="3"></textarea>
                                <span asp-validation-for="Problem" class="text-danger"></span>
                            </div>

                            <!--Nursing diagnosis-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Diagnosis">Nursing diagnosis<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                <textarea asp-for="Diagnosis" value="@Model.Diagnosis" class="form-control text-box multi-line" rows="3"></textarea>
                                <span asp-validation-for="Diagnosis" class="text-danger"></span>
                            </div>

                            <!--Goal/Objective-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Objective">Goal/Objective<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                <textarea asp-for="Objective" value="@Model.Objective" class="form-control text-box multi-line" rows="3"></textarea>
                                <span asp-validation-for="Objective" class="text-danger"></span>
                            </div>

                            <!--Nurse Intervention-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Intervension">Nurse intervention<span class="text-danger" style="font-size: 15px;"> *</span></label>
                                <textarea asp-for="Intervension" value="@Model.Intervension" class="form-control text-box multi-line" rows="3"></textarea>
                                <span asp-validation-for="Intervension" class="text-danger"></span>
                            </div>

                            <!--Rational-->
                            <div class="form-group mb-3 me-2 ms-2">
                                <label asp-for="Rational">Rational</label>
                                <textarea asp-for="Rational" value="@Model.Rational" class="form-control text-box multi-line" rows="3"></textarea>
                                <span asp-validation-for="Rational" class="text-danger"></span>
                            </div>

                            <!--Evaluation-->
                            <div class="form-group mb-2 me-2 ms-2">
                                <label asp-for="Evaluation">Evaluation</label>
                                <textarea asp-for="Evaluation" value="@Model.Evaluation" class="form-control text-box multi-line" rows="3"></textarea>
                                <span asp-validation-for="Evaluation" class="text-danger"></span>
                            </div>

                        </fieldset>
                    </div>
                    <!--card-body END-->

                    <div class="col-12 text-center mb-3">
                        <button class="btn btn-primary btn-big mt-1 mx-2" type="submit" role="button"><span> Save</span></button>
                        <a class="btn btn-big-back mt-1 mx-2" href="/NursingCare/Index"><span> Back</span></a>
                    </div>
                </div>
                @*</div>*@
            </div>

            <!--Daily observation-->
            <div class="col-md-3 mt-2">
                @await Component.InvokeAsync("DailyObservation")
            </div>
        </div>
    </form>
    <!--Body content End-->
</div>
<!--Main container End-->
@section Scripts
{
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.min.css" />
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/jquery-datetimepicker/2.5.20/jquery.datetimepicker.full.min.js"></script>
<script>
    $(document).ready(function() {
        $('input#DateOfCare').datetimepicker({
            timepicker:false,
            format:'Y-m-d',
            maxDate:0,
            minDate: 0
        });
        $('input#TimeOfCare').datetimepicker({
            datepicker:false,
            format:'H:i'
        });
    });
</script>
}

