@using IPD.Domain.Dto
@using static IPD.Domain.Constants.Enumerators
@using IPD.Web.Extensions
@model InterDepartmentReferralDto
@{
    ViewData["Title"] = "InterReferrals Details";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var departments = ViewBag.Departments as List<DepartmentsDto> ?? new List<DepartmentsDto>();
    var patient = ViewBag.Patient as PatientDto ?? new PatientDto();
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container-fluid mt-3">
    <div class="col-md-12 text-center">
        <h1 class="text-center mt-3" style="font-size:36px;font-weight:700">Inter Department Referral</h1>
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6 ">
            <div class="card mt-2">
                <div class="card-body">
                    <div class="alert alert-info">
                        <h4>Record saved successfully.</h4>
                    </div>

                    <table class="table">
                        <tbody>
                            <tr>
                                @{
                                    var department = departments.FirstOrDefault(x => x.DepartmentID == Model.DepartmentID);
                                }
                                <td width="30%">Department</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@department?.DepartmentName</td>
                            </tr>
                            <tr>
                                <td width="30%">Date of referral</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Date.ToString("MMM-dd-yyyy")</td>
                            </tr>
                            <tr>
                                <td width="30%">Time of referral</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Time.ToString("HH:mm")</td>
                            </tr>
                            <tr>
                                <td width="30%">Referral to</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">
                                    @Model.ReferralTo
                                </td>
                            </tr>
                            <tr>
                                <td width="30%">Patient name</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@ViewBag.ClientName</td>
                            </tr>
                            <tr>
                                <td width="30%">Age</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@DateTime.Now.GetYearsMonthsDaysText(patient.DOB)</td>
                            </tr>
                            <tr>
                                @{
                                    var sexSelectedItems = Html.GetEnumSelectList(typeof(Sex));
                                    var sexItem = sexSelectedItems.FirstOrDefault(x => x.Value == patient.Sex.ToString());
                                    string sexText = sexItem?.Text ?? string.Empty;
                                }
                                <td width="30%">Gender</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@sexText</td>
                            </tr>
                            <tr>
                                <td width="30%">Ward</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Ward</td>
                            </tr>
                            <tr>
                                <td width="30%">Referral officer</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.ReferralOfficer</td>
                            </tr>
                            <tr>
                                <td width="30%">Reason(s) for referral</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.ReasonOfReferral</td>
                            </tr>
                            <tr>
                                <td width="30%">Feedback</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.Feedback</td>
                            </tr>
                            <tr>
                                <td width="30%">Consulting officer</td>
                                <td width="3%" align="center">:</td>
                                <td width="67%">@Model.ConsultingOfficer</td>
                            </tr>
                        </tbody>
                    </table>
                    <p>
                        <a class="btn btn-primary mx-2 backBtn" href="@Url.ActionLink("Index", "InterReferrals")" style="text-align: center; line-height: 28px;">Finish</a>
                    </p>
                </div>
            </div>
        </div>

        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>
    <!--Body content End-->
</div>
<!--Main container End-->
