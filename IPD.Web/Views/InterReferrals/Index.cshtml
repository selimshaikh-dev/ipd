@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model List<InterDepartmentReferralDto>

@{
    ViewBag.Title = "InterReferrals";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var departments = ViewBag.Departments as List<DepartmentsDto> ?? new List<DepartmentsDto>();
    var patient = ViewBag.Patient as PatientDto ?? new PatientDto();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Main container Start-->
<div class="container-fluid mt-3">

    <div class="col-md-12">
        <h1 class="mt-3 text-center" style="font-size:36px; font-weight:700;">Inter Department Referral</h1>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>

    <!--Header-->
    <div class="mt-3" style="width:100%;">
        @await Component.InvokeAsync("ClientInfo", new { patientId = ViewBag.ClientId, isShowAdmissionInformation = true })
    </div>

    <!--Body content Start-->
    <div class="row mt-3">
        <!--Chief Complaint-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("ClinicalAssessment")
        </div>

        <div class="col-md-6 mt-2">
            <a class="btn btn-primary btn-big fs-6" href="@Url.ActionLink("Create", "InterReferrals")"><span>Add New</span></a>
            @if (Model.Any()) 
            {
            @foreach(var interReferral in Model)
            {
                <div class="card mt-3 mb-3">
                    <div class="card-body pb-0">
                        <table class="table" style="font-size: 15px;">
                            <tbody>
                                <tr>                                  
                                     <td colspan="6" class="fs-5 text-secondary shadow-sm" style="background-color: rgba(0,0,0,.03);">
                                       <span>Inter Referral</span>
                                       <span class="float-end">
                                            <a href="@Url.ActionLink("Edit", "InterReferrals", new { interDepartmentReferralsId = interReferral.InterDepartmentReferralsID})" class="btn btn-primary backBtn"> Edit</a>
                                        </span>
                                    </td>
                                </tr>

                                <tr>
                                    <th>Patient name</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                       @ViewBag.ClientName
                                    </td>
                                </tr>

                                <tr>
                                    <th>Age</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                       @DateTime.Now.GetYearsMonthsDaysText(patient.DOB)
                                    </td>
                                </tr>

                                <tr>
                                    @{
                                        var department = departments.FirstOrDefault(x => x.DepartmentID == interReferral.DepartmentID);
                                    }
                                    <th width="30%">Department</th>
                                    <td width="3">:</td>
                                    <td width="67%">@department?.DepartmentName</td>
                                </tr>

                                <tr>
                                    <th>Date of referral</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                        @interReferral.Date.ToString("dd-MM-yyyy")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Time of referral</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                        @interReferral.Time.ToString("HH:mm")
                                    </td>
                                </tr>

                                <tr>
                                    <th>Referral to</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                        @interReferral.ReferralTo
                                    </td>
                                </tr> 

                                <tr>
                                    <th>Referral officer</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                       @interReferral.ReferralOfficer
                                    </td>
                                </tr>

                                <tr>
                                    <th>Reason(s) for Referral</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                       @interReferral.ReasonOfReferral
                                    </td>
                                </tr>

                                <tr>
                                    <th>Consulting/Officer</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                       @interReferral.ConsultingOfficer
                                    </td>
                                </tr>

                                <tr>
                                    <th>Feedback</th>
                                    <td width="3">:</td>
                                    <td width="67%">
                                       @interReferral.Feedback
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
        <a href="/Referral/ReferralOptions" class="btn btn-sm-back mt-3 mb-3">Back</a>
        </div>
        <!--Daily observation-->
        <div class="col-md-3 mt-2">
            @await Component.InvokeAsync("DailyObservation")
        </div>
    </div>   
    <!--Body content End-->
</div>
<!--Main container End-->
