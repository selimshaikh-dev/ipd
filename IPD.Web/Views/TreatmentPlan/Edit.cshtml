@using IPD.Domain.Dto
@using IPD.Web.Extensions
@model TreatmentPlanDto

@{
    ViewData["Title"] = "Clinical Assessment";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
    var patient = ViewBag.Patient as PatientEditDto ?? new PatientEditDto();
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<!--Logo-->
<div class="col-12">
    <img src="/images/CMIS.png" width="150" height="70" class="img-fluid mx-auto d-block">
</div>

<!--Main container Start-->
<div class="container mt-3">
    <div class="col-md-10 offset-1 text-center">
        <h1 class="mt-3" style="font-size:36px;font-weight:700">Treatment Plan</h1>
        <h5 style="font-weight:600">All fields marked by (<span class="bi bi-asterisk text-danger" style="font-size:12px;"></span>) are mandatory.</h5>
        <hr class="mt-4" style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">
    </div>
        <!--Header-->
    <div class="col-md-10 offset-md-1 mt-4">
        @await Component.InvokeAsync("ClientClinicInfo")
    </div>
    <!--Body content Start-->
    <form asp-controller="TreatmentPlan" name="TreatementPlanDetailsForm" asp-action="Edit" method="post" onsubmit="return validateForm()">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="row mt-3">
            <!--Chief complaint-->
            <div class="col-md-3 offset-md-1 mt-2">
                @await Component.InvokeAsync("ClinicalAssessment")
            </div>

            <!--Diagnosis-->
            <div class="col-md-7">
                <div class="card mx-auto mt-2">
                    <div class="card-header text-secondary">
                        Treatment Plan
                    </div>
                    <!--Card-body START-->
                    <div class="card-body pe-4">
                        <fieldset>
                            <!--Treatment plan-->
                            <div class="form-group mb-3 me-2 ms-2 row">
                                <input asp-for="AdmissionID" type="hidden" />
                                <input asp-for="TreatmentPlanID" type="hidden" />

                                <label asp-for="TreatementPlanDetails">  Treatment / Management plan<span class="text-danger" style="font-size: 14px;"> *</span></label>
                                <textarea asp-for="TreatementPlanDetails" id="TreatementPlanDetails" class="form-control text-box multi-line" rows="6"></textarea>
                                <span asp-validation-for="TreatementPlanDetails" id="TreatementPlanDetailsError" class="text-danger"></span>
                            </div>
                        </fieldset>
                    </div>
                    <!--card-body END-->
                    <div class="col-12 text-center mb-3">
                        <button class="btn btn-primary btn-big mt-1 mx-2" type="submit" role="button"><span> Save</span></button>
                        <a class="btn btn-big-back mt-1 mx-2" href="/TreatmentPlan/Index"><span> Back</span></a>
                    </div>
                </div>
               
            </div>
        </div>
    </form>
    <!--Body content End-->
</div>
<!--Main container End-->


<script>
    //Validation form
        function validateForm() {
        let a = document.forms["TreatementPlanDetailsForm"]["TreatementPlanDetails"].value;

        if (a == "") {
                document.getElementById("TreatementPlanDetailsError").innerHTML = "The treatement plan details is required!";
                return false;
            } else {
                document.getElementById("TreatementPlanDetailsError").innerHTML = " ";
            }
        }
</script>
