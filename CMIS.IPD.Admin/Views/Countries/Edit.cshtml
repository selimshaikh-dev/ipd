@model IPD.Domain.Entities.Country

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="row m-4">
    <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")

    <div class="col-md-8 mt-2">
        <h4>
            Country
        </h4>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                Country
            </h6>
            
            <form asp-action="Edit" asp-controller="Countries" method="post">
                <input type="hidden" asp-for="CountryID" />
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="Name" class="col-sm-3 col-form-label">Country Name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7">
                            <input asp-for="Name" type="text" name="Name" class="form-control" id="name">
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <span id="userValidation"  class="text-danger">Country Name already exist!!</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-save m-2">Save</button>
                         <a href="@Url.ActionLink("Index", "Countries")" type="button" class="btn btn-back m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {

<script>
            $(document).ready(function(){
            $("#userValidation").hide();
            })

               $("#name").on("keyup", function(){

             var searchid = $(this).val().trim();
             searchid.split(' ').join('')              
            var url = `/Countries/GetAllCountry`
            $.ajax({
              url: url,
              cache: false,
              success: function(data){
                  console.log(data);
                  $.each(data, function (i, item) {
                            if(item.name.trim().toUpperCase() === searchid.toUpperCase()){
                              $('#userValidation').show();
                              $("#btnUpdate").attr( "disabled", "disabled" ); 
                                 return false;
                            }else{
                             $("#btnUpdate").removeAttr("disabled");
                             $('#userValidation').hide();
                            }
                });
              }
             });

    });

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}






