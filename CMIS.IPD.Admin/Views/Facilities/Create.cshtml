@model IPD.Domain.Entities.Facility

@{
    ViewData["Title"] = "Facility";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="row m-4">
    <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")

    <div class="col-md-8 mt-2">
        <h4>New Facility</h4>
        <hr style="height:1px; width:102%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                Facility
            </h6>
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="FacilityName" class="col-sm-3 col-form-label text-end">Facility Name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7">
                            <input asp-for="FacilityName" class="form-control" id="facilityName"/>
                            <span asp-validation-for="FacilityName" class="text-danger"></span>
                            <span id="userValidation" class="text-danger">Facility Name already exist!!</span>
                        </div>

                        <label asp-for="FacilityCode" class="col-sm-3 col-form-label text-end mt-2">Facility Code<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7 mt-3">
                            <input asp-for="FacilityCode" class="form-control" id="facilityCode"/>
                            <span asp-validation-for="FacilityCode" class="text-danger"></span>
                            <span id="userValidations" class="text-danger">Facility Code already exist!!</span>
                        </div>

                        <label asp-for="Longitude" class="col-sm-3 col-form-label text-end mt-2">Longitude</label>
                        <div class="col-sm-7 mt-3">
                            <input asp-for="Longitude" class="form-control"/>
                        </div>

                        <label asp-for="Latitude" class="col-sm-3 col-form-label text-end mt-2">Latitude</label>
                        <div class="col-sm-7 mt-3">
                            <input asp-for="Latitude" class="form-control"/>
                        </div>

                        <label asp-for="Telephone" class="col-sm-3 col-form-label text-end mt-2">Telephone</label>
                        <div class="col-sm-7 mt-3">
                            <input asp-for="Telephone" class="form-control"/>
                        </div>

                        <label class="col-sm-3 col-form-label text-end mt-2">Region Name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7 mt-3">
                            <select asp-for="RegionID" class="form-control" asp-items="ViewBag.RegionID"></select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-save m-2">Create</button>
                        <a href="@Url.ActionLink("Index", "Facilities")" type="button" class="btn btn-back m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function(){
        $("#userValidation").hide();
        $("#userValidations").hide();
    })

        $("#facilityName").on("keyup", function(){

        var searchid = $(this).val().trim();
        searchid.split(' ').join('')              
    var url = `/Facilities/GetAllFacilities`
    $.ajax({
        url: url,
        cache: false,
        success: function(data){
            console.log(data);
            $.each(data, function (i, item) {
                if(item.facilityName.trim().toUpperCase() === searchid.toUpperCase()){
                    $('#userValidation').show();
                    $("#btnSave").attr( "disabled", "disabled" ); 
                        return false;
                }else{
                    $("#btnSave").removeAttr("disabled");
                    $('#userValidation').hide();
                }
        });
        }
    });
    });

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}
