@model IPD.Domain.Entities.Allergy

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="row m-4">
    <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")

    <div class="col-md-8 mt-2">
        <h4>
            Region
        </h4>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                Region
            </h6>
            
            <form asp-action="Edit" asp-controller="Allergies" method="post">
                <input type="hidden" asp-for="AllergiesID" />
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="AllergiesName" class="col-sm-3 col-form-label">Allergies Name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7">
                            <input asp-for="AllergiesName" type="text" name="AllergiesName" class="form-control" id="allergiesName">
                            <span asp-validation-for="AllergiesName" class="text-danger"></span>
                            <span id="userValidation" class="text-danger">Allergies Name already exist!!</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-save m-2">Update</button>
                         <a href="@Url.ActionLink("Index", "Allergies")" type="button" class="btn btn-back m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {

<script>
    $(document).ready(function(){
        $("#userValidation").hide();
    })

        $("#allergiesName").on("keyup", function(){

        var searchid = $(this).val().trim();
        searchid.split(' ').join('')              
    var url = `/Allergies/GetAllAllergy`
    $.ajax({
        url: url,
        cache: false,
        success: function(data){
            console.log(data);
            $.each(data, function (i, item) {
                    if(item.allergiesName.trim().toUpperCase() === searchid.toUpperCase()){
                        $('#userValidation').show();
                        $("#btnSave").attr( "disabled", "disabled" ); 
                            return false;
                    }else{
                        $("#btnSave").removeAttr("disabled");
                        $('#userValidation').hide();
                    }
        });
        }
        });
    });

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}