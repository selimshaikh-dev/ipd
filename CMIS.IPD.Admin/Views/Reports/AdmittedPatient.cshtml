<div class="row custom-margin-parent-div gx-4 gy-4">
    @Html.Partial("_LeftNavigation")

    <div class="col-lg-9 col-md-8 col-sm-12">
        <div class="container-fluid mt-3">
            <div class="card mb-1">
                <div class="card-body border-0" style="background-color: #F39C12 ;">
                    <h5 class="text-center">Admitted patient's' report</h5>
                </div>
               
            </div>

            <div class="col-sm-12 col-md-12 col-lg-12 ">
                <form >
                    <div class="card">
                    <div class="card-body">
                        <div class="row ">
                            <b style="font-size:14px;">FacilityName:</b>
                            <div class="form-group mb-2 me-4 ms-4 row mt-1">
                                <label for="Date" class="col-md-3 text-end mt-1">From Date:</label>
                                <div class="col-md-4">
                                    <input type="date" name="FromDate" value="" data-val-required="The Date is required." class="form-control input-White">
                                    <span for="FromDate" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group mb-2 me-4 ms-4 row mt-1">
                                <label for="" class="col-md-3 text-end mt-1">To Date:</label>
                                <div class="col-md-4">
                                    <input type="Date" name="ToDate" value="" data-val-required="The DateCollected is required." class="form-control input-White">
                                    <span for="ToDate" class="text-danger"></span>
                                </div>
                            </div>
                             <div class="text-center mb-3 ms-5">
                                    <button type="submit" class="btn btn-primary mb-3 btn-lg mx-2 mt-3" asp-action="Showreport">
                                        Export PDF
                                    </button>
                                    @*<button type="submit" class="btn btn-primary mb-3 btn-lg mx-2 mt-3">
                                        Export PDF
                                    </button>*@
                                </div>
                        </div>
                    </div>
                </div>
                </form>
            </div>
        </div>
    </div>
</div>









