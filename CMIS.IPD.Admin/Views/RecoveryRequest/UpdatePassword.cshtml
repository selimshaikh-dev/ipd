@model IPD.Domain.Entities.UserAccount
@{
    ViewBag.Title = "UpdatePassword";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<style>
    .form-control{
        height: 40px !important;
    }
</style>

<div class="row m-4">
     @Html.Partial("_LeftNavigation")

    <div class="col-md-8">
        <h2>Password Recovery</h2>
        <hr />

        <form asp-action="UpdatePassword" asp-controller="RecoveryRequest" method="post">
            <div class="card">
                <div class="card-header">
                    Login/Access Details
                </div>
                <div class="card-body mt-2">
                    <!--USERNAME-->
                    <div class="form-group row">
                        <label asp-for="Username" class="col-sm-3 col-form-label text-end">Username</label>
                        <div class="col-md-7">
                            <input asp-for="Username" class="form-control" id = "txtUsername"/>
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <!--PASSWORD-->
                        <label asp-for="Password" class="col-sm-3 col-form-label text-end mt-3">Password<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-7 mt-3">
                            <input asp-for="Password" id="password" name="Password" class="form-control" data-val-required="Password is required." value="@Model.Password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!--confirm password-->
                        <label for="ConfirmPassword" class="col-sm-3 col-form-label text-end mt-3">Confirm password<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-md-7 mt-3">
                            <input for="ConfirmPassword" id="confirm_password" name="ConfirmPassword" data-val-required="Confirm password is required." type="password" class="form-control" value="@Model.Password" />
                            <span validation-for="ConfirmPassword" id='message'></span>
                        </div>

                    <!--HIDDEN FIELDS-->
                    @Html.HiddenFor(model => model.UserAccountID)
                    @Html.HiddenFor(model => model.NationalID)
                    @Html.HiddenFor(model => model.FirstName)
                    @Html.HiddenFor(model => model.MiddleName)
                    @Html.HiddenFor(model => model.LastName)
                    @Html.HiddenFor(model => model.DOB)
                    @Html.HiddenFor(model => model.Sex)
                    @Html.HiddenFor(model => model.CellphoneCountryCode)
                    @Html.HiddenFor(model => model.Cellphone)
                    @Html.HiddenFor(model => model.LandPhoneCountryCode)
                    @Html.HiddenFor(model => model.LandPhone)
                    @Html.HiddenFor(model => model.Email)
                    @Html.HiddenFor(model => model.ContactAddress) 
                    @Html.HiddenFor(model => model.FacilityID)
                    @Html.HiddenFor(model => model.FacilityCode)
                    @Html.HiddenFor(model => model.UserType)
                    @Html.HiddenFor(model => model.DateCreated)
                    @Html.HiddenFor(model => model.CreatedBy)
                    @Html.HiddenFor(model => model.AccountStatus)
                    @Html.HiddenFor(model => model.IsAccountActive)
                    @Html.HiddenFor(model => model.IsAdministrator)
                    @Html.HiddenFor(model => model.IsRowDeleted)

                    @*@Html.HiddenFor(model => model.UserAccess)*@
                    <input type="hidden" name="RecoveryRequestID" value="@ViewBag.RecoveryRequestID" /> 
                    </div>
                </div>
            </div>

            <div class="card mt-3 text-center">
                <div class="card-body">
                    <div class="form-group">
                        <div class="offset-2 col-md-8">
                            <button class="btn btn-primary btn-lg mx-2" type="submit" value="Save"><span> Save</span></button>
                            <a href="@Url.ActionLink("Index", "RecoveryRequest")" type="button" class="btn btn-primary btn-lg mx-2">Back</a>
                        </div>
                    </div>
                </div> 
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/2.1.1/jquery.min.js"></script>
    <script>
        $(document).ready(function () {
            DisableInput();

            function DisableInput() {
                $("#txtUsername").bind("keypress, keydown", false);
            }
        });

        $('#password, #confirm_password').on('keyup', function () {
          if ($('#password').val() == $('#confirm_password').val()) {
            $('#message').html('Matching').css('color', 'green');
          } else 
            $('#message').html('Not Matching').css('color', 'red');
        });
    </script>
}


