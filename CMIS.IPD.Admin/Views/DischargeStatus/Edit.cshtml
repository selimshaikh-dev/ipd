@model IPD.Domain.Entities.DischargeStatus

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="row m-4">
     <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")


    <div class="col-md-8 mt-2">
        <h4>
            Discharge Status
        </h4>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                Discharge Status
            </h6>
            
            <form asp-action="Edit" asp-controller="DischargeStatus" method="post">
                <input type="hidden" asp-for="DischargeStatusID" />
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="DischargesStatus" class="col-sm-3 col-form-label">Discharge Status<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7">
                            <input asp-for="DischargesStatus" type="text" required name="DischargesStatus" class="form-control" id="name">
                            <span asp-validation-for="DischargesStatus" class="text-danger"></span>
                            <span id="userValidation" class="text-danger">Discharges status  already exist!!</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-save m-2">Save</button>
                         <a href="@Url.ActionLink("Index", "DischargeStatus")" type="button" class="btn btn-back m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

<script>
    $(document).ready(function(){
        $("#userValidation").hide();
    })

        $("#name").on("keyup", function(){

        var searchid = $(this).val().trim();
        searchid.split(' ').join('')              
    var url = `/DischargeStatus/GetAllDischargeStatus`
    $.ajax({
        url: url,
        cache: false,
        success: function(data){
            console.log(data);
            $.each(data, function (i, item) {
                if(item.dischargesStatus.trim().toUpperCase() === searchid.toUpperCase()){
                    $('#userValidation').show();
                    $("#btnSave").attr( "disabled", "disabled" ); 
                        return false;
                }else{
                    $("#btnSave").removeAttr("disabled");
                    $('#userValidation').hide();

                }
        });
        }
        });

    });

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}