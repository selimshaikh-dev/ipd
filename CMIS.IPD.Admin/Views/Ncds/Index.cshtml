@model IEnumerable<IPD.Domain.Entities.Ncd>

@{
   ViewData["Title"] = "Country";
   Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<div class="row custom-margin-parent-div">
   <!--Left Navigation-->
   @Html.Partial("_LeftNavigation")

   <div class="col-lg-8 col-md-8 col-sm-12 pt-2">
      <h4>
         Ncds
      </h4>
      <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

      <div class="mb-3 mt-3 row">
         <div class="col-lg-5 col-md-12 col-sm-12">
            <h5>Type Ncd Name </h5>
         </div>
         <div class="col-lg-4 col-md-8 col-sm-8 pt-2">
            <input id="myInput" class="form-control form-size" placeholder="Search here"  />
         </div>
         <div class="col-lg-3 col-md-4 col-sm-4 pt-2">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
         </div>
      </div>

      <div class="row table-responsive ps-2">
         <table class="table table-responsive mt-2">
            <thead>
               <tr>
                  <th>
                     @Html.DisplayNameFor(model => model.NcdName)
                  </th>
                  <th></th>
               </tr>
            </thead>
            <tbody id="myTable">
               @foreach (var item in Model)
               {
                  <tr>
                     <td>
                        @Html.DisplayFor(modelItem => item.NcdName)
                     </td>
                     <td>
                        <a asp-action="Edit" class="btn btn-primary" asp-route-id="@item.NcdsID">Edit</a>
                     </td>
                  </tr>
               }
            </tbody>
         </table>
      </div>
   </div>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<script>
   $(document).ready(function() {

       $("#myInput").on("keyup", function() {
           var value = $(this).val().toLowerCase();
           $("#myTable tr").filter(function() {
               $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
           });
       });
   });
</script>
