@model IPD.Domain.Entities.Procedure

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="row m-4">
    <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")

    <div class="col-md-8 mt-2">
        <h4>
            Procedure
        </h4>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                Procedure
            </h6>
            
            <form asp-action="Create" asp-controller="Procedures" method="post">
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="ProcedureName" class="col-sm-3 col-form-label">Procedure Name<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7">
                            <input asp-for="ProcedureName" type="text" name="ProcedureName" class="form-control" id="procedureName">
                            <span asp-validation-for="ProcedureName" class="text-danger"></span>
                            <span id="userValidation" class="text-danger">Procedure Name already exist!!</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-save m-2">Create</button>
                        <a href="@Url.ActionLink("Index", "Procedures")" type="button" class="btn btn-back m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
<script>
    $(document).ready(function(){
        $("#userValidation").hide();
    })

        $("#procedureName").on("keyup", function(){

        var searchid = $(this).val().trim();
        searchid.split(' ').join('')              
    var url = `/Procedures/GetAllProcedure`
    $.ajax({
        url: url,
        cache: false,
        success: function(data){
            console.log(data);
            $.each(data, function (i, item) {
                if(item.procedureName.trim().toUpperCase() === searchid.toUpperCase()){
                    $('#userValidation').show();
                    $("#btnSave").attr( "disabled", "disabled" ); 
                        return false;
                }else{
                    $("#btnSave").removeAttr("disabled");
                    $('#userValidation').hide();

                }
        });
        }
    });

    });

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}