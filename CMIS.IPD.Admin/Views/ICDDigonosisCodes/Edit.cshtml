@model IPD.Domain.Entities.ICDDigonosisCode

@{
    ViewData["Title"] = "ICDDigonosisCode";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}

<div class="row m-4">
    <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")

    <div class="col-md-8 mt-2">
        <h4>
            ICD Digonosis Code
        </h4>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                ICD Digonosis Code
            </h6>
            
            <form asp-action="Edit" asp-controller="ICDDigonosisCodes" method="post">
                 <input type="hidden" asp-for="DiseaseID" />
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="ICDCode" class="col-sm-3 col-form-label">ICDCode</label>
                        <div class="col-sm-7">
                            <input asp-for="ICDCode" type="text" name="ICDCode" class="form-control" id="iCDCode">
                            <span asp-validation-for="ICDCode" class="text-danger"></span>
                            <span id="userValidation"  class="text-danger">ICDCode already exist!!</span>
                        </div>

                        <label asp-for="Description" class="col-sm-3 col-form-label">Description</label>
                        <div class="col-sm-7 mt-2">
                            <input asp-for="Description" type="text" name="Description" class="form-control" id="description">
                            <span asp-validation-for="Description" class="text-danger"></span>
                            @*<span id="userValidation"  class="text-danger">Description already exist!!</span>*@
                        </div>

                        <label asp-for="ParentsID" class="col-sm-3 col-form-label">Parents ID</label>
                        <div class="col-sm-7 mt-2">
                            <select asp-for="ParentsID" class="form-control" asp-items="ViewBag.categories">
                                <value selected>0</value>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-primary m-2">Update</button>
                        <a href="@Url.ActionLink("Index", "ICDDigonosisCodes")" type="button" class="btn btn-secondary m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
<script>
            $(document).ready(function(){
             $("#userValidation").hide();
            })

               $("#description").on("keyup", function(){

             var searchid = $(this).val().trim();
             searchid.split(' ').join('')              
            var url = `/ICDDigonosisCodes/GetAllICDDigonosisCode`
            $.ajax({
              url: url,
              cache: false,
              success: function(data){
                  console.log(data);
                  $.each(data, function (i, item) {
                            if(item.description.trim().toUpperCase() === searchid.toUpperCase()){
                             $('#userValidation').show();
                             $("#btnSave").attr( "disabled", "disabled" ); 
                                 return false;
                            }else{
                             $("#btnSave").removeAttr("disabled");
                             $('#userValidation').hide();

                            }
                });
              }
             });

    });

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}
