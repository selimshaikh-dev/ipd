@model IPD.Domain.Entities.Department

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomLayout.cshtml";
}
<!--Custom CSS-->
<link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />

<div class="row m-4">
    <!--Left Navigation-->
    @Html.Partial("_LeftNavigation")

    <div class="col-md-8 mt-2">
        <h4>
            Departments
        </h4>
        <hr style="height:1px; width:100%; border-width:0; color:#a6a6a6; background-color:#a6a6a6;">

        <div class="card mt-2">
            <h6 class="card-header text-secondary">
                Departments
            </h6>
        
            <form asp-action="Create" asp-controller="Departments" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
                <div class="card-body mt-2">
                    <div class="form-group row">
                        <label asp-for="DepartmentName" class="col-sm-3 col-form-label">Departments<span class="text-danger" style="font-size:14px;"> *</span></label>
                        <div class="col-sm-7">
                            <input asp-for="DepartmentName" type="text" name="DepartmentName" class="form-control" id="departmentName">
                            <span asp-validation-for="DepartmentName" class="text-danger"></span>
                            <span id="userValidation"  class="text-danger">Department Name already exist!!</span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center mt-2">
                        <button type="submit" id="btnSave" class="btn btn-save m-2">Create</button>
                        <a href="@Url.ActionLink("Index", "Departments")" type="button" class="btn btn-back m-2">Back</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function(){
        $("#userValidation").hide();
    })

        $("#departmentName").on("keyup", function(){

        var searchid = $(this).val().trim();
        searchid.split(' ').join('')              
    var url = `/Departments/GetAllDepartments`
    $.ajax({
        url: url,
        cache: false,
        success: function(data){
            console.log(data);
            $.each(data, function (i, item) {
            if(item.departmentName.trim().toUpperCase() === searchid.toUpperCase()){
                $('#userValidation').show();
                $("#btnSave").attr( "disabled", "disabled" ); 
                    return false;
            }else{
                $("#btnSave").removeAttr("disabled");
                $('#userValidation').hide();
            }
        });
        }
    });
});

</script>
    @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}